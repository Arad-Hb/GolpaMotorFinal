@model GolpaMotorFinal.Models.ViewModels.WarrantyManagement.RegisterationCardViewModel
@{
    ViewData["Title"] = "ثبت گارانتی";
    ViewData["RegisterAction"] = "Register";
    ViewData["CustomerTypeLabel"] = "نقش شما";
}

<div class="warranty-card-page auth-page">
    <div class="card auth-card" style="max-width:720px;margin:0 auto;">
        <div class="card-body p-4">
            <div class="text-center mb-3">
                <img src="~/pluto/images/logo/logo-golpa.png" alt="گلپا" class="img-fluid mb-3" style="max-height:80px;" />
                <h3 class="fw-bold mb-0" style="color:#04264e">ثبت گارانتی گلپا موتور</h3>
            </div>
            @await Html.PartialAsync("_RegisterCardForm", Model)
        </div>
        <div class="card-footer bg-white text-center text-success">
            <small>
                <i class="fa fa-shield-virus"></i>
                اطلاعات شما نزد گلپا موتور محفوظ است.
            </small>
        </div>
    </div>
</div>
