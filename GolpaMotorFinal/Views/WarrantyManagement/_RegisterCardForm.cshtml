@model GolpaMotorFinal.Models.ViewModels.WarrantyManagement.RegisterationCardViewModel
@using System.Collections.Generic
@{
    var actionName = ViewData["RegisterAction"] as string ?? "Register";
    var codes = Model.ScratchedCode is { Count: > 0 } ? Model.ScratchedCode : new List<string> { "" };
    var cardCount = codes.Count > 10 ? 10 : codes.Count;
}

@if (Model.op != null && !string.IsNullOrWhiteSpace(Model.op.Message))
{
    <div class="alert @(Model.op.Success ? "alert-success" : "alert-danger") py-2 mb-2">
        @Model.op.Message
    </div>
}
@if (TempData["FailedCards"] is string failedCards && !string.IsNullOrWhiteSpace(failedCards))
{
    <div class="alert alert-warning py-2 mb-2">@failedCards</div>
}
<div asp-validation-summary="ModelOnly" class="text-danger"></div>
<form asp-action="@actionName" asp-controller="WarrantyManagement" method="post" class="admin-form warranty-register-form" id="warrantyRegisterForm">
    @Html.AntiForgeryToken()
    <div id="warrantyContainer" data-next-index="@cardCount" data-max-cards="10">
        @for (var i = 0; i < cardCount; i++)
        {
            <div class="warranty-row">
                
                @* @if (i == 0)
                {
                    <label class="form-label">رمز</label>
                } *@
                <div class="warranty-code-input-wrap">
                    <input type="text"
                           name="ScratchedCode[@i]"
                           value="@codes[i]"
                           class="form-control warranty-scratch-input"
                           maxlength="50"
                           placeholder="رمز را وارد کنید" />
                           
                   </div>
                    <span class="warranty-code-status" aria-live="polite"></span>
                   <div>
                    @if (i == 0)
                    {
                        <button type="button"
                                id="btnAddWarranty"
                                class="btn btn-add-extra-warranty"
                                data-bs-toggle="tooltip"
                                data-bs-placement="top"
                                data-bs-title="افزودن چند کارت گارانتی (حداکثر ۱۰ کارت)"
                                aria-label="افزودن چند کارت گارانتی (حداکثر ۱۰ کارت)">
                            <i class="fa fa-plus-circle"></i>
                        </button>
                    }
                    else
                    {
                        <button type="button" class="btn text-danger remove-row" data-bs-toggle="tooltip" data-bs-title="حذف این کارت" aria-label="حذف این کارت">
                            <i class="fa fa-trash"></i>
                        </button>
                    }
                </div>
               
            </div>

        }
    </div>
    <div class="warranty-contact-row">
        <div class="warranty-phone">
            <label asp-for="CustomerPhoneNumber" class="form-label">
                <span class="text-danger">*</span>
                شماره موبایل
            </label>
            <div class="input-group">
                <span class="input-group-text">
                    <i class="fa fa-mobile-phone text-secondary"></i>
                </span>
                <input asp-for="CustomerPhoneNumber"
                       class="form-control text-start"
                       placeholder="09120000000" />
            </div>
            <span asp-validation-for="CustomerPhoneNumber" class="text-danger small"></span>
        </div>
        <div class="warranty-role-select">
            <label class="form-label" for="customerTypeSelect">نقش</label>
            <select id="customerTypeSelect" class="form-select">
                <option value="">انتخاب</option>
                @foreach (var item in Model.CustomerTypes)
                {
                    if (Model.CustomerTypeId?.ToString() == item.Value)
                    {
                        <option value="@item.Value" selected>@item.Text</option>
                    }
                    else
                    {
                        <option value="@item.Value">@item.Text</option>
                    }
                }
            </select>
        </div>
    </div>
    <div class="warranty-role-buttons">
        <label class="form-label">نقش مشتری</label>
        <div class="customer-type-list">
            @foreach (var item in Model.CustomerTypes)
            {
                var id = $"customerType_{item.Value}";
                <input asp-for="CustomerTypeId"
                       type="radio"
                       class="btn-check"
                       id="@id"
                       value="@item.Value"
                       autocomplete="off" />
                <label class="btn customer-type-btn" for="@id">
                    @item.Text
                </label>
            }
        </div>
        <span asp-validation-for="CustomerTypeId" class="text-danger"></span>
    </div>
    <div class="warranty-name-row">
        <div>
            <label asp-for="FirstName" class="form-label">نام</label>
            <div class="input-group">
                <span class="input-group-text">
                    <i class="fa fa-user" style="color:#04264e"></i>
                </span>
                <input asp-for="FirstName" class="form-control" placeholder="نام را وارد کنید" />
            </div>
            <span asp-validation-for="FirstName" class="text-danger small"></span>
        </div>
        <div>
            <label asp-for="LastName" class="form-label">نام خانوادگی</label>
            <div class="input-group">
                <span class="input-group-text">
                    <i class="fa fa-user" style="color:#04264e"></i>
                </span>
                <input asp-for="LastName" class="form-control" placeholder="نام خانوادگی را وارد کنید" />
            </div>
            <span asp-validation-for="LastName" class="text-danger small"></span>
        </div>
    </div>
    <div class="form-actions form-actions--block">
        <button type="submit" id="btnRegisterWarranty" class="main_bt" style="background-color:#0D214B!important;"
                data-retry-after="@Model.RateLimitRetryAfterSeconds">
            ثبت و فعال‌سازی گارانتی
        </button>
    </div>
</form>
