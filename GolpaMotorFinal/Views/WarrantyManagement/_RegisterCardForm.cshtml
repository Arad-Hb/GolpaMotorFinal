@model GolpaMotorFinal.Models.ViewModels.WarrantyManagement.RegisterationCardViewModel
@using System.Collections.Generic
@{
    var actionName = ViewData["RegisterAction"] as string ?? "Register";
    var typeLabel = ViewData["CustomerTypeLabel"] as string ?? "نقش شما";
    var serials = Model.SerialNumber is { Count: > 0 } ? Model.SerialNumber : new List<string> { "" };
    var codes = Model.ScratchedCode ?? new List<string>();
}

@if (Model.op != null && !string.IsNullOrWhiteSpace(Model.op.Message))
{
    <div class="alert @(Model.op.Success ? "alert-success" : "alert-danger")">
        @Model.op.Message
    </div>
}
@if (TempData["FailedCards"] is string failedCards && !string.IsNullOrWhiteSpace(failedCards))
{
    <div class="alert alert-warning">@failedCards</div>
}
<div asp-validation-summary="ModelOnly" class="text-danger"></div>
<form asp-action="@actionName" asp-controller="WarrantyManagement" method="post" class="admin-form">
    @Html.AntiForgeryToken()
    <div id="warrantyContainer" data-next-index="@serials.Count">
        @for (var i = 0; i < serials.Count; i++)
        {
            var code = i < codes.Count ? codes[i] : "";
            <div class="card mb-3 warranty-row">
                <div class="card-body">
                    <div class="row g-3 align-items-end">
                        <div class="col-12 col-md-5">
                            <label class="form-label">شماره سریال</label>
                            <input type="text"
                                   name="SerialNumber[@i]"
                                   value="@serials[i]"
                                   class="form-control"
                                   placeholder="شماره سریال را وارد کنید" />
                        </div>
                        <div class="col-12 col-md-5">
                            <label class="form-label">رمز</label>
                            <input type="text"
                                   name="ScratchedCode[@i]"
                                   value="@code"
                                   class="form-control"
                                   placeholder="رمز را وارد کنید" />
                        </div>
                        @if (i > 0)
                        {
                            <div class="col-12 col-md-2">
                                <button type="button" class="btn text-danger remove-row">حذف</button>
                            </div>
                        }
                    </div>
                </div>
            </div>
        }
    </div>
    <div class="mb-4 d-flex justify-content-between align-items-center px-2 text-success">
        <span>افزودن چند کارت گارانتی </span>
        <button type="button" id="btnAddWarranty" class="btn btn-add-extra-warranty">
            <i class="fa fa-plus-circle text-success"></i>
        </button>
    </div>
    <div class="mb-4">
        <label asp-for="CustomerPhoneNumber" class="form-label fw-semibold">
            <span class="text-danger">*</span>
            شماره موبایل
        </label>
        <div class="input-group">
            <span class="input-group-text">
                <i class="fa fa-mobile-phone text-secondary"></i>
            </span>
            <input asp-for="CustomerPhoneNumber"
                   class="form-control text-start"
                   placeholder="09120000000" />
        </div>
        <span asp-validation-for="CustomerPhoneNumber" class="text-danger small"></span>
    </div>
    <div class="mb-4">
        <label class="form-label fw-bold">@typeLabel</label>
        <div class="d-flex flex-wrap gap-2">
            @foreach (var item in Model.CustomerTypes)
            {
                var id = $"customerType_{item.Value}";
                <input asp-for="CustomerTypeId"
                       type="radio"
                       class="btn-check"
                       id="@id"
                       value="@item.Value"
                       autocomplete="off" />
                <label class="btn customer-type-btn" for="@id">
                    @item.Text
                </label>
            }
        </div>
        <span asp-validation-for="CustomerTypeId" class="text-danger"></span>
    </div>
    <div class="row">
        <div class="col-12 col-md-6 mb-3">
            <label asp-for="FirstName" class="form-label">نام</label>
            <div class="input-group">
                <span class="input-group-text">
                    <i class="fa fa-user" style="color:#04264e"></i>
                </span>
                <input asp-for="FirstName" class="form-control" placeholder="نام را وارد کنید" />
            </div>
            <span asp-validation-for="FirstName" class="text-danger small"></span>
        </div>
        <div class="col-12 col-md-6 mb-3">
            <label asp-for="LastName" class="form-label">نام خانوادگی</label>
            <div class="input-group">
                <span class="input-group-text">
                    <i class="fa fa-user" style="color:#04264e"></i>
                </span>
                <input asp-for="LastName" class="form-control" placeholder="نام خانوادگی را وارد کنید" />
            </div>
            <span asp-validation-for="LastName" class="text-danger small"></span>
        </div>
    </div>
    <div class="d-grid mt-4">
        <button type="submit" class="btn btn-lg text-light fw-bold" style="background-color:#04264e">
            ثبت و فعال‌سازی گارانتی
        </button>
    </div>
</form>
<script>
    (function () {
        var container = document.getElementById("warrantyContainer");
        var addBtn = document.getElementById("btnAddWarranty");
        if (!container || !addBtn || addBtn.dataset.bound === "1") return;
        addBtn.dataset.bound = "1";
        var index = parseInt(container.getAttribute("data-next-index") || "1", 10);
        addBtn.addEventListener("click", function () {
            container.insertAdjacentHTML("beforeend", `
                <div class="card mb-3 warranty-row">
                    <div class="card-body">
                        <div class="row g-3 align-items-end">
                            <div class="col-md-5">
                                <label class="form-label">شماره سریال</label>
                                <input type="text" name="SerialNumber[${index}]" class="form-control" placeholder="شماره سریال را وارد کنید" />
                            </div>
                            <div class="col-md-5">
                                <label class="form-label">رمز</label>
                                <input type="text" name="ScratchedCode[${index}]" class="form-control" placeholder="رمز را وارد کنید" />
                            </div>
                            <div class="col-2">
                                <button type="button" class="btn text-danger remove-row">حذف</button>
                            </div>
                        </div>
                    </div>
                </div>`);
            index++;
        });
        document.addEventListener("click", function (e) {
            var btn = e.target.closest(".remove-row");
            if (btn) btn.closest(".warranty-row").remove();
        });
    })();
</script>
