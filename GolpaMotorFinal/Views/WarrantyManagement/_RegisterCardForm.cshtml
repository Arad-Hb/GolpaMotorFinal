@model GolpaMotorFinal.Models.ViewModels.WarrantyManagement.RegisterationCardViewModel
@using System.Collections.Generic
@{
    var actionName = ViewData["RegisterAction"] as string ?? "Register";
    var typeLabel = ViewData["CustomerTypeLabel"] as string ?? "نقش شما";
    var codes = Model.ScratchedCode is { Count: > 0 } ? Model.ScratchedCode : new List<string> { "" };
    var cardCount = codes.Count > 10 ? 10 : codes.Count;
}

@if (Model.op != null && !string.IsNullOrWhiteSpace(Model.op.Message))
{
    <div class="alert @(Model.op.Success ? "alert-success" : "alert-danger")">
        @Model.op.Message
    </div>
}
@if (TempData["FailedCards"] is string failedCards && !string.IsNullOrWhiteSpace(failedCards))
{
    <div class="alert alert-warning">@failedCards</div>
}
<div asp-validation-summary="ModelOnly" class="text-danger"></div>
<form asp-action="@actionName" asp-controller="WarrantyManagement" method="post" class="admin-form" id="warrantyRegisterForm">
    @Html.AntiForgeryToken()
    <div id="warrantyContainer" data-next-index="@cardCount" data-max-cards="10">
        @for (var i = 0; i < cardCount; i++)
        {
            <div class="card mb-3 warranty-row">
                <div class="card-body">
                    <div class="row g-3 align-items-end">
                        <div class="col-12 col-md-10">
                            <label class="form-label">رمز</label>
                            <input type="text"
                                   name="ScratchedCode[@i]"
                                   value="@codes[i]"
                                   class="form-control"
                                   maxlength="50"
                                   placeholder="رمز را وارد کنید" />
                        </div>
                        @if (i > 0)
                        {
                            <div class="col-12 col-md-2">
                                <button type="button" class="btn text-danger remove-row"><i class="fa fa-trash"></i></button>
                            </div>
                        }
                    </div>
                </div>
            </div>
        }
    </div>
    <div class="mb-4 d-flex justify-content-between align-items-center px-2 text-success">
        <span>افزودن چند کارت گارانتی (حداکثر ۱۰ کارت)</span>
        <button type="button" id="btnAddWarranty" class="btn btn-add-extra-warranty">
            <i class="fa fa-plus-circle text-success"></i>
        </button>
    </div>
    <div class="mb-4">
        <label asp-for="CustomerPhoneNumber" class="form-label fw-semibold">
            <span class="text-danger">*</span>
            شماره موبایل
        </label>
        <div class="input-group">
            <span class="input-group-text">
                <i class="fa fa-mobile-phone text-secondary"></i>
            </span>
            <input asp-for="CustomerPhoneNumber"
                   class="form-control text-start"
                   placeholder="09120000000" />
        </div>
        <span asp-validation-for="CustomerPhoneNumber" class="text-danger small"></span>
    </div>
    <div class="mb-4">
        <label class="form-label fw-bold">@typeLabel</label>
        <div class="d-flex flex-wrap gap-2">
            @foreach (var item in Model.CustomerTypes)
            {
                var id = $"customerType_{item.Value}";
                <input asp-for="CustomerTypeId"
                       type="radio"
                       class="btn-check"
                       id="@id"
                       value="@item.Value"
                       autocomplete="off" />
                <label class="btn customer-type-btn" for="@id">
                    @item.Text
                </label>
            }
        </div>
        <span asp-validation-for="CustomerTypeId" class="text-danger"></span>
    </div>
    <div class="row">
        <div class="col-12 col-md-6 mb-3">
            <label asp-for="FirstName" class="form-label">نام</label>
            <div class="input-group">
                <span class="input-group-text">
                    <i class="fa fa-user" style="color:#04264e"></i>
                </span>
                <input asp-for="FirstName" class="form-control" placeholder="نام را وارد کنید" />
            </div>
            <span asp-validation-for="FirstName" class="text-danger small"></span>
        </div>
        <div class="col-12 col-md-6 mb-3">
            <label asp-for="LastName" class="form-label">نام خانوادگی</label>
            <div class="input-group">
                <span class="input-group-text">
                    <i class="fa fa-user" style="color:#04264e"></i>
                </span>
                <input asp-for="LastName" class="form-control" placeholder="نام خانوادگی را وارد کنید" />
            </div>
            <span asp-validation-for="LastName" class="text-danger small"></span>
        </div>
    </div>
    <div class="d-grid mt-4">
        <button type="submit" id="btnRegisterWarranty" class="btn btn-lg text-light fw-bold" style="background-color:#04264e"
                data-retry-after="@Model.RateLimitRetryAfterSeconds">
            ثبت و فعال‌سازی گارانتی
        </button>
    </div>
</form>
<script>
    (function () {
        var container = document.getElementById("warrantyContainer");
        var addBtn = document.getElementById("btnAddWarranty");
        var form = document.getElementById("warrantyRegisterForm");
        var submitBtn = document.getElementById("btnRegisterWarranty");
        if (!container || !addBtn || addBtn.dataset.bound === "1") return;
        addBtn.dataset.bound = "1";

        var maxCards = parseInt(container.getAttribute("data-max-cards") || "10", 10);
        var lockStorageKey = "warrantyRegisterLockUntil";
        var defaultLabel = "ثبت و فعال‌سازی گارانتی";
        var lockTimer = null;

        function rowCount() {
            return container.querySelectorAll(".warranty-row").length;
        }

        function reindexRows() {
            var rows = container.querySelectorAll(".warranty-row");
            rows.forEach(function (row, i) {
                var input = row.querySelector("input[type='text']");
                if (input) input.name = "ScratchedCode[" + i + "]";
            });
        }

        function syncAddButton() {
            addBtn.disabled = rowCount() >= maxCards;
        }

        addBtn.addEventListener("click", function () {
            if (rowCount() >= maxCards) return;
            var index = rowCount();
            container.insertAdjacentHTML("beforeend",
                '<div class="card mb-3 warranty-row">' +
                    '<div class="card-body">' +
                        '<div class="row g-3 align-items-end">' +
                            '<div class="col-12 col-md-10">' +
                                '<label class="form-label">رمز</label>' +
                                '<input type="text" name="ScratchedCode[' + index + ']" class="form-control" maxlength="50" placeholder="رمز را وارد کنید" />' +
                            '</div>' +
                            '<div class="col-12 col-md-2">' +
                                '<button type="button" class="btn text-danger remove-row"><i class="fa fa-trash"></i></button>' +
                            '</div>' +
                        '</div>' +
                    '</div>' +
                '</div>');
            syncAddButton();
        });

        document.addEventListener("click", function (e) {
            var btn = e.target.closest(".remove-row");
            if (!btn || !container.contains(btn)) return;
            var row = btn.closest(".warranty-row");
            if (row) row.remove();
            reindexRows();
            syncAddButton();
        });

        function remainingLockSeconds() {
            try {
                var until = parseInt(sessionStorage.getItem(lockStorageKey) || "0", 10);
                if (!until) return 0;
                return Math.max(0, Math.ceil((until - Date.now()) / 1000));
            } catch (e) {
                return 0;
            }
        }

        function setLockUntil(seconds) {
            if (!seconds || seconds <= 0) return;
            try {
                sessionStorage.setItem(lockStorageKey, String(Date.now() + seconds * 1000));
            } catch (e) { }
        }

        function applyLockUi() {
            if (!submitBtn) return;
            var remaining = remainingLockSeconds();
            if (lockTimer) {
                clearInterval(lockTimer);
                lockTimer = null;
            }
            if (remaining <= 0) {
                submitBtn.disabled = false;
                submitBtn.textContent = defaultLabel;
                try { sessionStorage.removeItem(lockStorageKey); } catch (e) { }
                return;
            }
            submitBtn.disabled = true;
            submitBtn.textContent = "لطفاً " + remaining + " ثانیه صبر کنید";
            lockTimer = setInterval(applyLockUi, 1000);
        }

        if (form && submitBtn) {
            form.addEventListener("submit", function () {
                if (submitBtn.disabled) return;
                setLockUntil(60);
                applyLockUi();
            });
        }

        var serverRetry = submitBtn ? parseInt(submitBtn.getAttribute("data-retry-after") || "", 10) : 0;
        if (serverRetry > 0) setLockUntil(serverRetry);

        applyLockUi();
        syncAddButton();
    })();
</script>
