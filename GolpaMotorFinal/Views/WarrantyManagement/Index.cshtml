@model GolpaMotorFinal.Models.ViewModels.WarrantyManagement.WarrantyAdminIndexViewModel
@using GolpaMotorFinal.Models.ViewModels.CRUD
@{
    Layout = "_AdminLayout";
    var openTab = string.IsNullOrWhiteSpace(Model.OpenTab) ? "cards" : Model.OpenTab;
}

<div class="row column1">
    <div class="col-md-6 col-lg-3">
        <div class="full counter_section">
            <div class="couter_icon"><div><i class="fa fa-check green_color"></i></div></div>
            <div class="counter_no">
                <p class="total_no">@(Model.Stats?.RegisteredCards ?? 0)</p>
                <p class="head_couter">ثبت‌شده</p>
            </div>
        </div>
    </div>
    <div class="col-md-6 col-lg-3">
        <div class="full counter_section">
            <div class="couter_icon"><div><i class="fa fa-clock yellow_color"></i></div></div>
            <div class="counter_no">
                <p class="total_no">@(Model.Stats?.UnregisteredCards ?? 0)</p>
                <p class="head_couter">باقی‌مانده</p>
            </div>
        </div>
    </div>
    <div class="col-md-6 col-lg-3">
        <div class="full counter_section">
            <div class="couter_icon"><div><i class="fa fa-box red_color"></i></div></div>
            <div class="counter_no">
                <p class="total_no">@(Model.Stats?.ProductsWithoutCards ?? 0)</p>
                <p class="head_couter">محصول بدون کارت</p>
            </div>
        </div>
    </div>
    <div class="col-md-6 col-lg-3">
        <div class="full counter_section">
            <div class="couter_icon"><div><i class="fa fa-gift purple_color"></i></div></div>
            <div class="counter_no">
                <p class="total_no">@(Model.Stats?.TotalRegisteredPoints ?? 0)</p>
                <p class="head_couter">امتیاز ثبت‌شده</p>
            </div>
        </div>
    </div>
</div>

@if (Model.LastImport != null)
{
    <div class="alert @(Model.LastImport.Success ? "alert-info" : "alert-danger")">
        @Model.LastImport.Message
    </div>
}

<ul class="nav nav-tabs mb-3" id="warrantyTab" role="tablist">
    <li class="nav-item">
        <button class="nav-link @(openTab == "cards" ? "active" : null)" id="tab-cards" data-bs-toggle="tab" data-bs-target="#warranty-cards" type="button" role="tab">لیست کارت‌ها</button>
    </li>
    <li class="nav-item">
        <button class="nav-link @(openTab == "register" ? "active" : null)" id="tab-register" data-bs-toggle="tab" data-bs-target="#warranty-form" type="button" role="tab">فرم ثبت کارت گارانتی</button>
    </li>
    <li class="nav-item">
        <button class="nav-link @(openTab == "excel" ? "active" : null)" id="tab-excel" data-bs-toggle="tab" data-bs-target="#warranty-excel" type="button" role="tab">ورود اکسل</button>
    </li>
    <li class="nav-item">
        <button class="nav-link @(openTab == "generate" ? "active" : null)" id="tab-generate" data-bs-toggle="tab" data-bs-target="#warranty-generate" type="button" role="tab">تولید سریال</button>
    </li>
</ul>

<div class="tab-content" id="warrantyTabContent">
    <div class="tab-pane fade @(openTab == "cards" ? "show active" : null)" id="warranty-cards" role="tabpanel">
        @await Html.PartialAsync("_CrudPage", new CrudIndexViewModel
        {
            GridId = "warrantyCardsGrid",
            ListHeading = "لیست کارت‌ها",
            FilterPartial = "_WarrantyCardFilterBar",
            FilterModel = Model
        })
    </div>

    <div class="tab-pane fade @(openTab == "register" ? "show active" : null)" id="warranty-form" role="tabpanel">
        <div class="white_shd full margin_bottom_30">
            <div class="padding_infor_info">
                @{
                    ViewData["RegisterAction"] = "RegisterForCustomer";
                    ViewData["CustomerTypeLabel"] = "نقش مشتری";
                }
                @await Html.PartialAsync("_RegisterCardForm", Model.RegistrationCard)
            </div>
        </div>
    </div>

    <div class="tab-pane fade @(openTab == "excel" ? "show active" : null)" id="warranty-excel" role="tabpanel">
        <div class="white_shd full margin_bottom_30">
            <div class="padding_infor_info">
                @if (Model.LastImport != null)
                {
                    <div class="alert @(Model.LastImport.Success ? "alert-info" : "alert-danger")">
                        @Model.LastImport.Message
                    </div>
                }
                <form asp-action="UploadExcel" method="post" enctype="multipart/form-data" class="admin-form">
                    @Html.AntiForgeryToken()
                    <p class="text-muted mb-3">ردیف اول عنوان ستون‌ها است. ستون A سریال، ستون B رمز، ستون C مدت اعتبار به ماه (مثلاً ۲۴). اگر ستون C خالی باشد ۱۲ ماه ذخیره می‌شود. اعتبار بعد از ثبت کارت شروع می‌شود.</p>
                    <div class="row g-2 align-items-end">
                        <div class="col-12 col-md-4">
                            <label class="form-label">محصول</label>
                            <select name="ProductID" class="form-select" required>
                                <option value="">انتخاب محصول</option>
                                @foreach (var item in Model.Products)
                                {
                                    <option value="@item.ProductID">@item.ProductName</option>
                                }
                            </select>
                        </div>
                        <div class="col-12 col-md-5">
                            <label class="form-label">فایل اکسل</label>
                            <input type="file" name="ExcelFile" accept=".xlsx" class="form-control" required />
                        </div>
                        <div class="col-12 col-md-3">
                            <button type="submit" class="main_bt w-100">آپلود اکسل</button>
                        </div>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <div class="tab-pane fade @(openTab == "generate" ? "show active" : null)" id="warranty-generate" role="tabpanel">
        <div class="white_shd full margin_bottom_30">
            <div class="padding_infor_info">
                <form asp-action="GenerateCodes" method="post" class="admin-form">
                    @Html.AntiForgeryToken()
                    <div class="row g-2 align-items-end">
                        <div class="col-4 col-md-4">
                            <label class="form-label">محصول</label>
                            <select name="productId" class="form-select" required>
                                <option value="">انتخاب محصول</option>
                                @foreach (var item in Model.Products)
                                {
                                    <option value="@item.ProductID">@item.ProductName</option>
                                }
                            </select>
                        </div>
                        <div class="col-2 col-md-2">
                            <label class="form-label">تعداد</label>
                            <input type="number" name="count" class="form-control" value="@Model.GenerateCount" min="1" max="200" />
                        </div>
                        <div class="col-2 col-md-2">
                            <label class="form-label">مدت اعتبار</label>
                            <input type="number" name="validityMonths" class="form-control" value="@Model.ValidityMonths" min="1" max="60" />
                        </div>
                        <div class="col-2 col-md-2">
                            <button type="submit" class="main_bt w-100">تولید سریال</button>
                        </div>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
