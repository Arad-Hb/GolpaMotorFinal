@model GolpaMotorFinal.Models.ViewModels.WarrantyManagement.WarrantyAdminIndexViewModel
@using GolpaMotorFinal.Helpers
@{
    var rowNumber = Model.PageIndex * PaginationViewModel.DefaultPageSize;
    var listUrl = FilterUrl.Combine("/WarrantyManagement/CardList", new
    {
        SearchTerm = Model.SearchTerm,
        ProductID = Model.ProductID,
        IsRegistered = Model.IsRegistered,
        ValidityPreset = Model.ValidityPreset,
        RemainingDaysFrom = Model.RemainingDaysFrom,
        RemainingDaysTo = Model.RemainingDaysTo,
        RegisteredFromJalali = Model.RegisteredFromJalali,
        RegisteredToJalali = Model.RegisteredToJalali
    });
}

<div class="table-responsive">
    <table class="table table-hover align-middle" id="warrantyCardsTable">
        <thead>
            <tr>
                <th class="table-num">#</th>
                <th>سریال</th>
                <th>رمز</th>
                <th>محصول</th>
                <th>وضعیت</th>
                <th>اعتبار (ماه)</th>
                <th>اعتبار باقی‌مانده</th>
            </tr>
        </thead>
        <tbody>
            @if (Model.Cards.Any())
            {
                foreach (var card in Model.Cards)
                {
                    rowNumber++;
                    <tr>
                        <td class="table-num">@rowNumber</td>
                        <td>@card.SerialNumber</td>
                        <td>@card.ScratchedCode</td>
                        <td>@card.ProductName</td>
                        <td>@(card.IsRegistered ? "ثبت‌شده" : "آزاد")</td>
                        <td>@card.ValidityMonths</td>
                        <td>@card.RemainingText</td>
                    </tr>
                }
            }
            else
            {
                <tr>
                    <td colspan="7" class="text-center text-muted">کارتی یافت نشد</td>
                </tr>
            }
        </tbody>
    </table>
</div>

@await Component.InvokeAsync("Pagination", PaginationViewModel.For(
    "warrantyCardsGrid",
    Model.PageIndex,
    Model.PageCount,
    Model.RecordCount,
    listUrl))
