@model GolpaMotorFinal.Models.ViewModels.Reports.ReportsIndexViewModel

@{
    Layout = "_AdminLayout";
}

<ul class="nav nav-tabs mb-3">
    @foreach (var tab in Model.Tabs)
    {
        var selected = Model.OpenTab == tab.Key;

        <li class="nav-item">
            <a class="nav-link @(selected ? "active" : "")"
               href="/reports/@tab.Key"
               aria-current="@(selected ? "page" : null)">
                @tab.Title
            </a>
        </li>
    }
</ul>

<div data-report-page="/reports/@Model.OpenTab">
    @await Html.PartialAsync("_CrudPage", Model.Page)
</div>

@section Scripts
{
    <script src="~/js/reports.js" asp-append-version="true"></script>
}