@model GolpaMotorFinal.Models.ViewModels.Reports.ReportsIndexViewModel
@using DomainModel.Models
@using GolpaMotorFinal.Models.ViewModels.CRUD
@{
    Layout = "_AdminLayout";
}

<ul class="nav nav-tabs mb-3" role="tablist">
    <li class="nav-item"><button class="nav-link active" data-bs-toggle="tab" data-bs-target="#reportUsers" type="button">گزارش کاربران</button></li>
    <li class="nav-item"><button class="nav-link" data-bs-toggle="tab" data-bs-target="#reportWarranty" type="button">گزارش کارت گارانتی</button></li>
    <li class="nav-item"><button class="nav-link" data-bs-toggle="tab" data-bs-target="#reportProducts" type="button">گزارش محصول</button></li>
    <li class="nav-item"><button class="nav-link" data-bs-toggle="tab" data-bs-target="#reportRewards" type="button">گزارش پاداش</button></li>
</ul>

<div class="tab-content">
    <div class="tab-pane fade show active" id="reportUsers">
        @await Html.PartialAsync("_CrudPage", new CrudIndexViewModel
        {
            GridId = "UserReportGrid",
            ListHeading = "گزارش کاربران",
            FilterPartial = "~/Views/UserManagement/_UserFilterBar.cshtml",
            FilterModel = new UserFilterBarViewModel
            {
                Url = "/Reports/Users",
                Target = "#UserReportGrid",
                CustomerTypes = ViewBag.CustomerTypes as IEnumerable<CustomerType> ?? Enumerable.Empty<CustomerType>(),
                Provinces = ViewBag.Provinces as IEnumerable<Province> ?? Enumerable.Empty<Province>()
            }
        })
    </div>
    <div class="tab-pane fade" id="reportWarranty">
        @await Html.PartialAsync("_CrudPage", new CrudIndexViewModel
        {
            GridId = "WarrantyReportGrid",
            ListHeading = "گزارش کارت گارانتی",
            FilterPartial = "_WarrantyReportFilterBar",
            FilterModel = Model.Products
        })
    </div>
    <div class="tab-pane fade" id="reportProducts">
        @await Html.PartialAsync("_CrudPage", new CrudIndexViewModel
        {
            GridId = "ProductReportGrid",
            ListHeading = "گزارش محصول",
            FilterPartial = "_ProductReportFilterBar",
            FilterModel = new ProductReportFilterBarViewModel
            {
                YearNow = Framework.Common.PersianDate.GetYear(DateTime.Today)
            }
        })
    </div>
    <div class="tab-pane fade" id="reportRewards">
        @await Html.PartialAsync("_CrudPage", new CrudIndexViewModel
        {
            GridId = "RewardReportGrid",
            ListHeading = "گزارش پاداش",
            FilterPartial = "_RewardReportFilterBar"
        })
    </div>
</div>
