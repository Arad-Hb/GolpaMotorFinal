@model GolpaMotorFinal.Models.ViewModels.Admin.TopRegistrarsPageViewModel
@{
    var rowNumber = Model.PageIndex * PaginationViewModel.DefaultPageSize;
    var listUrl = Url.Action("TopRegistrars", "Admin") ?? "/Admin/TopRegistrars";
}

<div class="table-responsive report-grid--compact">
    <table class="table table-striped table-hover align-middle" id="topRegistrarsTable">
        <thead>
            <tr>
                <th class="table-num">#</th>
                <th>کاربر</th>
                <th>موبایل</th>
                <th>شغل</th>
                <th>استان</th>
                <th>شهر</th>
                <th>وضعیت</th>
                <th>تعداد ثبت</th>
            </tr>
        </thead>
        <tbody>
            @if (Model.Items != null && Model.Items.Any())
            {
                foreach (var item in Model.Items)
                {
                    rowNumber++;
                    <tr>
                        <td class="table-num">@rowNumber</td>
                        <td>
                            <a href="@Url.Action("UserCards", "Reports", new { id = item.UserID })"
                               class="text-decoration-none fw-semibold">@item.FullName</a>
                        </td>
                        <td>@(item.PhoneNumber ?? "—")</td>
                        <td>@(item.JobTitle ?? "—")</td>
                        <td>@(item.Province ?? "—")</td>
                        <td>@(item.City ?? "—")</td>
                        <td>
                            <span class="badge @(item.IsActive ? "bg-success" : "bg-danger")">
                                @(item.IsActive ? "فعال" : "غیرفعال")
                            </span>
                        </td>
                        <td class="table-num">@item.RegistrationCount.ToGroupedNumber()</td>
                    </tr>
                }
            }
            else
            {
                <tr>
                    <td colspan="8" class="text-muted text-center">هنوز ثبتی وجود ندارد</td>
                </tr>
            }
        </tbody>
    </table>
</div>

@await Component.InvokeAsync("Pagination", PaginationViewModel.For(
    "topRegistrarsGrid",
    Model.PageIndex,
    Model.PageCount,
    Model.RecordCount,
    listUrl))
