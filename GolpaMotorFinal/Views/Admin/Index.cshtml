@model GolpaMotorFinal.Models.ViewModels.Admin.AdminDashboardViewModel
@{
    ViewData["Title"] = "داشبورد";
    Layout = "_AdminLayout";
    var stats = Model.Stats;
}

@await Html.PartialAsync("_AdminPageHeader", AdminPageHeaderViewModel.For("داشبورد"))

<div class="row column1">
    <div class="col-md-6 col-lg-3">
        <div class="full counter_section">
            <div class="couter_icon">
                <div>
                    <i class="fa fa-shield-halved green_color"></i>
                </div>
            </div>
            <div class="counter_no">
                <p class="total_no">@(stats?.RegisteredCards ?? 0)</p>
                <p class="head_couter">گارانتی ثبت‌شده</p>
            </div>
        </div>
    </div>
    <div class="col-md-6 col-lg-3">
        <div class="full counter_section">
            <div class="couter_icon">
                <div>
                    <i class="fa fa-clock yellow_color"></i>
                </div>
            </div>
            <div class="counter_no">
                <p class="total_no">@(stats?.UnregisteredCards ?? 0)</p>
                <p class="head_couter">گارانتی باقی‌مانده</p>
            </div>
        </div>
    </div>
    <div class="col-md-6 col-lg-3">
        <div class="full counter_section">
            <div class="couter_icon">
                <div>
                    <i class="fa fa-triangle-exclamation red_color"></i>
                </div>
            </div>
            <div class="counter_no">
                <p class="total_no">@(stats?.ProductsWithoutCards ?? 0)</p>
                <p class="head_couter">محصول بدون گارانتی</p>
            </div>
        </div>
    </div>
    <div class="col-md-6 col-lg-3">
        <div class="full counter_section">
            <div class="couter_icon">
                <div>
                    <i class="fa fa-gift purple_color"></i>
                </div>
            </div>
            <div class="counter_no">
                <p class="total_no">@(stats?.TotalRegisteredPoints ?? 0)</p>
                <p class="head_couter">امتیاز ثبت‌شده</p>
            </div>
        </div>
    </div>
</div>

<div class="row">
    <div class="col-md-6">
        <div class="white_shd full margin_bottom_30">
            <div class="full graph_head d-flex justify-content-between align-items-center">
                <div class="heading1 margin_0"><h2>محصولات پرمصرف</h2></div>
                <a class="small" asp-controller="Reports" asp-action="Index">گزارش کامل</a>
            </div>
            <div class="padding_infor_info">
                <ul class="list-unstyled mb-0">
                    @foreach (var item in Model.TopProducts)
                    {
                        <li class="d-flex justify-content-between py-1"><span>@item.Name</span><strong>@item.Count</strong></li>
                    }
                </ul>
            </div>
        </div>
    </div>
    <div class="col-md-6">
        <div class="white_shd full margin_bottom_30">
            <div class="full graph_head d-flex justify-content-between align-items-center">
                <div class="heading1 margin_0"><h2>پاداش‌های پرتقاضا</h2></div>
                <a class="small" asp-controller="Reports" asp-action="Index">گزارش کامل</a>
            </div>
            <div class="padding_infor_info">
                <ul class="list-unstyled mb-0">
                    @foreach (var item in Model.TopRewards)
                    {
                        <li class="d-flex justify-content-between py-1"><span>@item.Name</span><strong>@item.Count</strong></li>
                    }
                </ul>
            </div>
        </div>
    </div>
</div>

<div class="white_shd full margin_bottom_30">
    <div class="full graph_head">
        <div class="heading1 margin_0">
            <h2>بیشترین ثبت‌کننده گارانتی</h2>
        </div>
    </div>
    <div class="table_section padding_infor_info">
        <div id="topRegistrarsGrid">
            @await Html.PartialAsync("_TopRegistrarsTable", Model.TopRegistrars)
        </div>
    </div>
</div>
