@{
    ViewData["Title"] = "داشبورد";
    Layout = "_AdminLayout";
    var stats = ViewBag.Stats as DomainModel.ViewModels.Product.ProductStatistics;
    var top = ViewBag.TopRegistrars as List<DomainModel.ViewModels.Product.NamedCountItem>;
}

<div class="mb-4">
    <div class="page-title">داشبورد مدیریت گارانتی</div>
    <div class="page-subtitle">آمار زنده فروشگاه</div>
</div>

<div class="row g-4 mb-4">
    <div class="col-xl-3 col-md-6">
        <div class="card dashboard-card">
            <div class="card-body">
                <div class="stat-icon bg-success">
                    <i class="fa-solid fa-shield-halved"></i>
                </div>
                <h3>@(stats?.RegisteredCards ?? 0)</h3>
                <p>گارانتی ثبت شده</p>
            </div>
        </div>
    </div>
    <div class="col-xl-3 col-md-6">
        <div class="card dashboard-card">
            <div class="card-body">
                <div class="stat-icon bg-warning">
                    <i class="fa-solid fa-clock"></i>
                </div>
                <h3>@(stats?.UnregisteredCards ?? 0)</h3>
                <p>گارانتی باقی مانده</p>
            </div>
        </div>
    </div>
    <div class="col-xl-3 col-md-6">
        <div class="card dashboard-card">
            <div class="card-body">
                <div class="stat-icon bg-danger">
                    <i class="fa-solid fa-triangle-exclamation"></i>
                </div>
                <h3>@(stats?.ProductsWithoutCards ?? 0)</h3>
                <p>محصول بدون گارانتی</p>
            </div>
        </div>
    </div>
    <div class="col-xl-3 col-md-6">
        <div class="card dashboard-card">
            <div class="card-body">
                <div class="stat-icon bg-purple">
                    <i class="fa-solid fa-gift"></i>
                </div>
                <h3>@(stats?.TotalRegisteredPoints ?? 0)</h3>
                <p>مجموع امتیاز ثبت‌شده</p>
            </div>
        </div>
    </div>
</div>

<div class="row g-4">
    <div class="col-lg-12">
        <div class="main-card p-4">
            <div class="section-title mb-3">
                <i class="fa-solid fa-users"></i>
                بیشترین ثبت‌کننده گارانتی
            </div>
            <table class="table">
                <thead>
                    <tr>
                        <th>کاربر</th>
                        <th>تعداد</th>
                    </tr>
                </thead>
                <tbody>
                    @if (top != null && top.Any())
                    {
                        foreach (var item in top)
                        {
                            <tr>
                                <td>@item.Name</td>
                                <td>@item.Count</td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="2" class="text-muted text-center">هنوز ثبتی وجود ندارد</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
