@using GolpaMotorFinal.Models.ViewModels.CRUD
@model CrudGridViewModel
@{
    var hasActions = Model.Rows.Any(r => r.Actions.Any(a => a.Visible));
    var colCount = Model.Headers.Count
        + (Model.ShowRowNumber ? 1 : 0)
        + (hasActions ? 1 : 0);
}
<div class="crud-grid" data-grid="@Model.GridId">
    <table>
        <thead>
            <tr>
                @if (Model.ShowRowNumber)
                {
                    <th class="crud-grid__num" data-bs-toggle="tooltip" data-bs-title="#" data-bs-placement="top">#</th>
                }
                @foreach (var header in Model.Headers)
                {
                    <th scope="col" data-bs-toggle="tooltip" data-bs-title="@header" data-bs-placement="top">@header</th>
                }
                @if (hasActions)
                {
                    <th class="crud-grid__actions" data-bs-toggle="tooltip" data-bs-title="عملیات" data-bs-placement="top">عملیات</th>
                }
            </tr>
        </thead>
        <tbody>
            @if (Model.Rows.Any())
            {
                int rowNumber = Model.StartRowNumber > 0 ? Model.StartRowNumber : 1;
                foreach (var row in Model.Rows)
                {
                    <tr>
                        @if (Model.ShowRowNumber)
                        {
                            <td class="crud-grid__num">@rowNumber</td>
                        }
                        @foreach (var column in row.Columns)
                        {
                            <td class="@column.CssClass @(column.Type == GridColumnType.Number ? "crud-grid__num" : null)">
                                @switch (column.Type)
                                {
                                    case GridColumnType.Image:
                                        var imageSrc = !string.IsNullOrWhiteSpace(column.ImageUrl)
                                            ? column.ImageUrl
                                            : column.Value?.ToString();
                                        <img src="@(string.IsNullOrWhiteSpace(imageSrc) ? "/images/pics/noimage.jpg" : imageSrc)"
                                             class="crud-grid__img"
                                             alt="" />
                                        break;
                                    case GridColumnType.Boolean:
                                        if (column.Value is bool flag)
                                        {
                                            <i class="@(flag ? column.TrueIcon : column.FalseIcon)"></i>
                                        }
                                        break;
                                    case GridColumnType.Badge:
                                        <span class="badge @column.BadgeClass">
                                            @(column.Value ?? column.EmptyText)
                                        </span>
                                        break;
                                    default:
                                        if (!string.IsNullOrWhiteSpace(column.ButtonUrl))
                                        {
                                            <a href="@column.ButtonUrl" class="crud-grid__link">
                                                @(column.Value ?? column.EmptyText)
                                            </a>
                                        }
                                        else
                                        {
                                            @(column.Value ?? column.EmptyText)
                                        }
                                        break;
                                }
                            </td>
                        }
                        @if (hasActions)
                        {
                            <td class="crud-grid__actions-cell">
                                @if (row.Actions.Count > 3)
                                {
                                    var dropdownId = $"crud-actions-{Guid.NewGuid():N}";

                                    <div class="crud-action-dropdown">
                                        <button type="button" class="crud-action-toggle" aria-expanded="false" aria-controls="@dropdownId" data-bs-toggle="tooltip" data-bs-title="عملیات" data-bs-placement="top">
                                            <span>عملیات</span>

                                            <svg class="crud-action-chevron" width="16" height="16" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
                                                <path d="m6 9 6 6 6-6" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
                                            </svg>
                                        </button>

                                        <ul id="@dropdownId" class="crud-action-options" hidden>
                                            @foreach (var action in row.Actions)
                                            {
                                                var css = action.CssClass ?? "";
                                                if (action.OpenModal && !action.IsDelete && !css.Contains("open-modal"))
                                                    css += " open-modal";
                                                if (action.IsDelete && !css.Contains("btnDelete"))
                                                    css += " btnDelete";
                                                if (!action.Ajax && !action.OpenModal && !action.IsDelete)
                                                {
                                                    <li class="crud-action-option">
                                                        <a href="@action.Url"
                                                           class="@css"
                                                           title="@action.ActionText"
                                                           data-bs-toggle="tooltip"
                                                           data-bs-title="@action.ActionText"
                                                           data-bs-placement="top">
                                                            <i class="@action.Icon"></i>
                                                        </a>
                                                    </li>
                                                }
                                                else
                                                {
                                                    <li class="crud-action-option">
                                                        <button type="button"
                                                                class="@css"
                                                                title="@action.ActionText"
                                                                data-bs-toggle="tooltip"
                                                                data-bs-title="@action.ActionText"
                                                                data-bs-placement="top"
                                                                data-title="@action.ActionText"
                                                                data-url="@action.Url"
                                                                data-id="@action.Id"
                                                                data-id-name="@(action.IdName ?? "userID")"
                                                                data-size="@(action.Size ?? "modal-lg")"
                                                                data-grid-id="@action.GridId"
                                                                data-refresh-url="@action.RefreshUrl"
                                                                data-refresh-target-url="@action.RefreshUrl"
                                                                data-refresh-target-id="@action.RefreshTargetId">
                                                            <i class="@action.Icon"></i>
                                                        </button>
                                                    </li>
                                                }
                                            }
                                        </ul>
                                    </div>
                                }
                                else
                                {
                                    <div class="crud-grid__action-btns">
                                        @foreach (var action in row.Actions.Where(a => a.Visible))
                                        {
                                            var css = action.CssClass ?? "";
                                            if (action.OpenModal && !action.IsDelete && !css.Contains("open-modal"))
                                                css += " open-modal";
                                            if (action.IsDelete && !css.Contains("btnDelete"))
                                                css += " btnDelete";
                                            if (!action.Ajax && !action.OpenModal && !action.IsDelete)
                                            {
                                                <a href="@action.Url"
                                                   class="@css"
                                                   title="@action.ActionText"
                                                   data-bs-toggle="tooltip"
                                                   data-bs-title="@action.ActionText"
                                                   data-bs-placement="top">
                                                    <i class="@action.Icon"></i>
                                                </a>
                                            }
                                            else
                                            {
                                                <button type="button"
                                                        class="@css"
                                                        title="@action.ActionText"
                                                        data-bs-toggle="tooltip"
                                                        data-bs-title="@action.ActionText"
                                                        data-bs-placement="top"
                                                        data-title="@action.ActionText"
                                                        data-url="@action.Url"
                                                        data-id="@action.Id"
                                                        data-id-name="@(action.IdName ?? "userID")"
                                                        data-size="@(action.Size ?? "modal-lg")"
                                                        data-grid-id="@action.GridId"
                                                        data-refresh-url="@action.RefreshUrl"
                                                        data-refresh-target-url="@action.RefreshUrl"
                                                        data-refresh-target-id="@action.RefreshTargetId">
                                                    <i class="@action.Icon"></i>
                                                </button>
                                            }
                                        }
                                    </div>
                                }
                            </td>
                        }
                    </tr>
                    rowNumber++;
                }
            }
            else
            {
                <tr class="crud-grid__empty">
                    <td colspan="@colCount">
                        @Model.EmptyMessage
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>

@if (Model.Pager != null)
{
    @await Component.InvokeAsync("Pagination", Model.Pager)
}
