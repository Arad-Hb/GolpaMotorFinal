@using GolpaMotorFinal.Models.ViewModels.CRUD
@model dynamic

<div class="table-responsive">

    <table class="table table-bordered table-hover align-middle">

        <thead class="table-dark">

            <tr>

                <th style="width:60px">#</th>

                @foreach (var column in Model.Columns)
                {
                    <th>@column.Header</th>
                }

                @if (Model.Actions.Count > 0)
                {
                    <th style="width:180px">
                        عملیات
                    </th>
                }

            </tr>

        </thead>

        <tbody>

            @{
                int row = 1;
            }

            @foreach (var item in Model.Items)
            {
                <tr>

                    <td>@row</td>

                    @foreach (var column in Model.Columns)
                    {
                        var value = column.Value(item);

                        <td class="@column.CssClass">

                            @switch (column.Type)
                            {
                                case GridColumnType.Image:

                                    <img src="@(string.IsNullOrWhiteSpace(value?.ToString())
                                                                        ? column.DefaultImage
                                                                        : value)"
                                         class="rounded"
                                         width="45"
                                         height="45" />

                                    break;

                                case GridColumnType.Boolean:

                                    if (value is bool b)
                                    {
                                        <i class="@(b ? column.TrueIcon : column.FalseIcon)"></i>
                                    }

                                    break;

                                case GridColumnType.Badge:

                                    <span class="badge @column.BadgeClass">
                                        @(value ?? column.EmptyText)
                                    </span>

                                    break;

                                case GridColumnType.PersianDate:

                                    @* Replace with your PersianDate extension *@
                                    @(value ?? column.EmptyText)

                                    break;

                                default:

                                    @(value ?? column.EmptyText)

                                    break;
                            }

                        </td>
                    }

                    @if (Model.Actions.Count > 0)
                    {
                        <td>

                            @foreach (var action in Model.Actions)
                            {
                                var id = action.Id(item);

                                <button class="@action.CssClass @(action.OpenModal ? "open-modal" : "")"
                                        data-title="@action.Title"
                                        data-url="@action.Url"
                                        data-id="@id">

                                    <i class="@action.Icon"></i>

                                </button>
                            }

                        </td>
                    }

                </tr>

                row++;
            }

        </tbody>

    </table>

</div>













