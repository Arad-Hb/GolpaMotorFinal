@model GolpaMotorFinal.Models.ViewModels.ProductManagement.ProductListPageViewModel
@using GolpaMotorFinal.Helpers
@{
    var f = Model.Filter ?? new DomainModel.ViewModels.Product.ProductSearchModel();
    var rowNumber = Model.PageIndex * PaginationViewModel.DefaultPageSize;
    var listUrl = FilterUrl.Combine("/ProductManagement/ProductList", new
    {
        f.ProductName,
        f.IsAvailable,
        f.PointsFrom,
        f.PointsTo,
        f.RegisteredFrom,
        f.RegisteredTo,
        f.RemainingFrom,
        f.RemainingTo
    });
}

<div class="table-responsive">
    <table class="table table-hover align-middle">
        <thead class="table-dark">
            <tr>
                <th class="table-num">#</th>
                <th>عکس</th>
                <th>نام محصول</th>
                <th class="table-num">امتیاز</th>
                <th>وضعیت</th>
                <th class="table-num">ثبت‌شده</th>
                <th class="table-num">باقی‌مانده</th>
                <th class="table-actions">عملیات</th>
            </tr>
        </thead>
        <tbody>
            @if (Model.Items != null && Model.Items.Any())
            {
                foreach (var prod in Model.Items)
                {
                    rowNumber++;
                    <tr>
                        <td class="table-num">@rowNumber</td>
                        <td>
                            <img src="@ImageHelper.Fix(prod.ImageUrl)"
                                 style="width:45px;height:45px;object-fit:cover;border-radius:6px;"
                                 alt="" />
                        </td>
                        <td>@prod.ProductName</td>
                        <td class="table-num">@prod.ProductPoint</td>
                        <td>@(prod.IsAvailable ? "موجود" : "ناموجود")</td>
                        <td class="table-num">@prod.RegisteredCardCount</td>
                        <td class="table-num">@prod.UnregisteredCardCount</td>
                        <td class="table-actions">
                            <button type="button"
                                    class="btn btn-sm btn-outline-secondary btnDetails"
                                    title="جزئیات"
                                    data-id="@prod.ProductID">
                                  <i class="fa fa-eye"></i>
                            </button>
                            <button type="button"
                                    class="btn btn-sm btn-outline-warning btnEdit"
                                    title="ویرایش"
                                    data-id="@prod.ProductID">
                                <i class="fa fa-pen"></i>
                            </button>
                            <button type="button" class="btn btn-sm btn-outline-danger btnDelete" title="حذف"
                                    data-id="@prod.ProductID"
                                    data-id-name="productID"
                                    data-url="@Url.Action("Delete", "ProductManagement")">
                                <i class="fa fa-trash"></i>
                            </button>
                            <button type="button"
                                    class="btn btn-sm btn-outline-danger btnRemovePicture"
                                    title="حذف عکس"
                                    data-id="@prod.ProductID">
                                <i class="fa fa-image"></i>
                            </button>
                        </td>
                    </tr>
                }
            }
            else
            {
                <tr>
                    <td colspan="8" class="text-center text-muted">محصولی یافت نشد</td>
                </tr>
            }
        </tbody>
    </table>
</div>

@await Component.InvokeAsync("Pagination", PaginationViewModel.For(
    "ProductGrid",
    Model.PageIndex,
    Model.PageCount,
    Model.RecordCount,
    listUrl))
