@model GolpaMotorFinal.Models.ViewModels.DateRangeFilterViewModel

<div class="date-range js-date-range" data-empty-label="@Model.EmptyLabel">
    <div class="date-range__control">
        <button type="button" class="date-range__nav" data-dir="-1" aria-label="بازه قبلی"><i class="fa-solid fa-chevron-right"></i></button>
        <button type="button" class="date-range__trigger" aria-haspopup="dialog">
            <i class="fa-solid fa-calendar-days"></i>
            <span class="date-range__label">@Model.EmptyLabel</span>
        </button>
        <button type="button" class="date-range__nav" data-dir="1" aria-label="بازه بعدی"><i class="fa-solid fa-chevron-left"></i></button>
    </div>
    <input type="text" name="@Model.FromName" value="@Model.FromValue" class="form-control js-jalali js-date-from js-date-range-input" placeholder="@Model.FromPlaceholder" autocomplete="off" tabindex="-1" aria-hidden="true" />
    <input type="text" name="@Model.ToName" value="@Model.ToValue" class="form-control js-jalali js-date-to js-date-range-input" placeholder="@Model.ToPlaceholder" autocomplete="off" tabindex="-1" aria-hidden="true" />
</div>
