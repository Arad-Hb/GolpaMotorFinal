
@model List<GolpaMotorFinal.Models.ViewModels.UserManagement.UserListItemViewModel>
@using GolpaMotorFinal.Helpers


<div class="main-card">
    <div class="p-4">

        <div class="section-title mb-3">
            <i class="fa fa-table text-primary"></i>
            لیست کاربران
        </div>

        <div class="table-responsive">
            <table class="table table-hover align-middle">

                <thead class="table-dark">
                    <tr>
                        <th>نام</th>
                        <th>موبایل</th>
                        <th>شغل</th>
                        <th>استان</th>
                        <th>شهر</th>
                        <th class="table-num">کارت</th>
                        <th class="table-num">امتیاز</th>
                        <th>واجد پاداش</th>
                        <th>دریافت پاداش</th>
                        <th class="table-actions">عملیات</th>
                    </tr>
                </thead>

                <tbody>
                    @if (Model != null && Model.Any())
                    {
                        foreach (var item in Model)
                        {
                            <tr>
                                <td>@item.FullName</td>
                                <td>@item.PhoneNumber</td>
                                <td>@item.RoleName</td>
                                <td>@item.Province</td>
                                <td>@item.City</td>
                                <td class="table-num">@item.TotalRegisteredCards</td>
                                <td class="table-num">@item.TotalEarnedPoints</td>
                                <td>@(item.IsEligibleForReward ? "بله" : "خیر")</td>
                                <td>@(item.HasReceivedReward ? "بله" : "خیر")</td>
                                <td class="table-actions">
                                    <button type="button" class="btn btn-sm btn-outline-success open-modal"
                                            title="ثبت درخواست پاداش"
                                            data-url='@Url.Action("EligibleRewards", "UserManagement")'
                                            data-title="درخواست پاداش مشتری"
                                            data-id="@item.UserID"
                                            data-id-name="userID">
                                        <i class="fa fa-gift"></i>
                                    </button>
                                    <button type="button" class="btn btn-sm btn-outline-secondary open-modal"
                                        title="جزئیات"
                                        data-url='@Url.Action("Details", "UserManagement")'
                                        data-title="جزئیات کاربر"
                                        data-id="@item.UserID"
                                        data-id-name="userID">
                                        <i class="fa fa-eye"></i>
                                    </button>
                                    <button type="button" class="btn btn-sm btn-outline-warning open-modal"
                                            title="ویرایش"
                                            data-url='@Url.Action("Edit", "UserManagement")'
                                            data-title="ویرایش کاربر"
                                            data-id="@item.UserID"
                                            data-id-name="userID">
                                        <i class="fa fa-pen"></i>
                                    </button>
                                    <button type="button" class="btn btn-sm btn-outline-primary open-modal"
                                            title="ادغام حساب"
                                            data-url='@Url.Action("MergeAccounts", "UserManagement")'
                                            data-title="ادغام حساب"
                                            data-id="@item.UserID"
                                            data-id-name="userID"
                                            data-grid-id="UserGrid"
                                            data-refresh-url="@Url.Action("Grid", "UserManagement")">
                                        <i class="fa fa-user-plus"></i>
                                    </button>
                                    <button type="button" class="btn btn-sm btn-outline-danger btnDelete"
                                            title="حذف"
                                            data-id="@item.UserID"
                                            data-id-name="userID"
                                            data-url='@Url.Action("Delete","UserManagement")'
                                            data-refresh-target-url='@Url.Action("Grid","UserManagement")'
                                            data-refresh-target-id="UserGrid">
                                        <i class="fa fa-trash"></i>
                                    </button>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="12" class="text-center text-muted">
                                هیچ کاربری یافت نشد
                            </td>
                        </tr>
                    }
                </tbody>

            </table>
        </div>

    </div>
</div>

