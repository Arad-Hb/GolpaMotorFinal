@model GolpaMotorFinal.Models.ViewModels.RewardManagement.RewardCatalogListPageViewModel

<div class="table-responsive">
    <table class="table table-hover align-middle">
        <thead class="table-dark">
            <tr>
                <th>عنوان</th>
                <th class="table-num">حد نصاب</th>
                <th>نوع</th>
                <th class="table-num">مبلغ</th>
                <th>وضعیت</th>
                <th class="table-num">درخواست</th>
                <th class="table-actions">عملیات</th>
            </tr>
        </thead>
        <tbody>
            @if (Model.Items != null && Model.Items.Any())
            {
                foreach (var item in Model.Items)
                {
                    <tr>
                        <td>@item.Title</td>
                        <td class="table-num">@item.RequiredPoints</td>
                        <td>@(item.IsCashReward ? "نقدی" : "غیرنقدی")</td>
                        <td class="table-num">@(item.IsCashReward ? item.CashValue?.ToString("N0") : "-")</td>
                        <td>@(item.IsActive ? "فعال" : "غیرفعال")</td>
                        <td class="table-num">@item.RequestCount</td>
                        <td class="table-actions">
                            <button type="button" class="btn btn-sm btn-outline-secondary btnDetailsCatalog" title="جزئیات" data-id="@item.RewardCatalogID">
                                <i class="fa fa-eye"></i>
                            </button>
                            <button type="button" class="btn btn-sm btn-outline-warning btnEditCatalog" title="ویرایش" data-id="@item.RewardCatalogID">
                                <i class="fa fa-pen"></i>
                            </button>
                            <button type="button" class="btn btn-sm btn-outline-danger btnDeleteCatalog" title="غیرفعال" data-id="@item.RewardCatalogID">
                                <i class="fa fa-trash"></i>
                            </button>
                        </td>
                    </tr>
                }
            }
            else
            {
                <tr>
                    <td colspan="7" class="text-center text-muted">پاداشی یافت نشد</td>
                </tr>
            }
        </tbody>
    </table>
</div>

@if (Model.PageCount > 1)
{
    <nav class="d-flex justify-content-center">
        <ul class="pagination">
            @for (var i = 0; i < Model.PageCount; i++)
            {
                <li class="page-item @(i == Model.PageIndex ? "active" : "")">
                    <a class="page-link catalog-page" href="#" data-page="@i">@(i + 1)</a>
                </li>
            }
        </ul>
    </nav>
}
