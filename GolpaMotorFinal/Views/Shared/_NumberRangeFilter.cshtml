@model NumberRangeFilterViewModel
<div class="num-range js-num-range" data-empty-label="@Model.EmptyLabel">
    <div class="num-range__control">
        <button type="button" class="num-range__nav" data-dir="-1" aria-label="بازه قبلی"><i class="fa-solid fa-chevron-right"></i></button>
        <button type="button" class="num-range__trigger" aria-haspopup="dialog">
            <i class="fa-solid fa-sliders"></i>
            <span class="num-range__label">@Model.EmptyLabel</span>
        </button>
        <button type="button" class="num-range__nav" data-dir="1" aria-label="بازه بعدی"><i class="fa-solid fa-chevron-left"></i></button>
    </div>
    <input type="number" name="@Model.FromName" value="@Model.FromValue" class="form-control js-num-from js-num-range-input" placeholder="@Model.FromPlaceholder" step="@Model.Step" inputmode="numeric" tabindex="-1" aria-hidden="true" />
    <input type="number" name="@Model.ToName" value="@Model.ToValue" class="form-control js-num-to js-num-range-input" placeholder="@Model.ToPlaceholder" step="@Model.Step" inputmode="numeric" tabindex="-1" aria-hidden="true" />
</div>
