@using GolpaMotorFinal.Helpers


<div class="topbar">
    <div class="topbar-wrapper">
        <div class="topbar-actions">
            <div>
                <i class="fa-solid fa-clock-o"></i>
                <span> @Framework.Common.Extensions.DateTimeExtensions.ToPersianDate(DateTime.Now) </span>
            </div>
            <div class="profile-box">
                <a asp-controller="Admin" asp-action="Profile" class="text-decoration-none text-reset d-flex align-items-center gap-2">
                <div>
                    <div class="profile-name">
                        @User.Identity?.Name
                    </div>
                    <div class="profile-role">
                        مدیر سیستم
                    </div>
                </div>
                <img src="~/images/pics/admin.jpg" class="profile-image" alt="admin">
                </a>
            </div>
        </div>
    </div>

</div>