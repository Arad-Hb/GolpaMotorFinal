@using Microsoft.AspNetCore.Identity
@using DomainModel.Models
@inject UserManager<ApplicationUser> UserManager
@{
    var adminUser = await UserManager.GetUserAsync(User);
    var displayName = string.Join(" ", new[] { adminUser?.FirstName, adminUser?.LastName }.Where(x => !string.IsNullOrWhiteSpace(x)));
    if (string.IsNullOrWhiteSpace(displayName))
        displayName = User.Identity?.Name ?? "مدیر";

    var iranNow = DateTime.UtcNow.ToIranTimeIso();
}
<div class="topbar">
    <div class="full">
        <button type="button" id="sidebarCollapse" class="sidebar_toggle" aria-label="منو" aria-controls="sidebar">
            <i class="fa fa-bars" aria-hidden="true"></i>
        </button>
        <div class="logo_section">
            <a asp-controller="Home" asp-action="Index" class="text-decoration-none">
                <span class="golpa-brand">
                    <img src="/images/pics/gipareverse.png" alt="golpa motor" class="golpa-brand-mark" />
                </span>
                @* <partial name="_PlutoBrand" /> *@
            </a>
        </div>
        <div class="right_topbar">
            <div class="icon_info">
                <ul>
                    <li>
                        <span class="text-light" id="live-clock"></span>
                        <span class="text-light">@DateTime.Now.ToPersianLongDate()</span>
                        
                    </li>
                </ul>
                <ul class="user_profile_dd">
                    <li class="dropdown">
                        <a class="dropdown-toggle" href="#" role="button" data-bs-toggle="dropdown" data-bs-display="static" aria-expanded="false">
                            <img class="rounded-circle" src="@(string.IsNullOrWhiteSpace(adminUser?.ProfileImageUrl) ? "/pluto/images/layout/user_img.jpg" : adminUser.ProfileImageUrl)" alt="" />
                            <span class="name_user">@displayName</span>
                        </a>
                        <ul class="dropdown-menu">
                            <li>
                                <a class="dropdown-item" asp-controller="Admin" asp-action="Profile">پروفایل من</a>
                            </li>
                            <li>
                                <form asp-controller="Account" asp-action="Logout" method="post" class="m-0">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="dropdown-item">خروج <i class="fa fa-right-from-bracket"></i></button>
                                </form>
                            </li>
                        </ul>
                    </li>
                </ul>
            </div>
        </div>
    </div>
</div>

<script>
    const iranTime = new Date("@iranNow");

    function updateClock() {
        iranTime.setSeconds(iranTime.getSeconds() + 1);

        document.getElementById("live-clock").innerText =
            iranTime.toLocaleString("fa-IR", {
                timeZone: "Asia/Tehran",
                hour: "2-digit",
                minute: "2-digit",
                second: "2-digit"
            });
    }

    updateClock();
    setInterval(updateClock, 1000);
</script>
