@{
    var placeholder = ViewData["SearchPlaceholder"] as string ?? "جستجو...";
    var name = ViewData["SearchName"] as string ?? "SearchTerm";
    var value = ViewData["SearchValue"] as string ?? "";
}
<div class="filter-search">
    <input type="search"
           name="@name"
           value="@value"
           class="form-control filter-search__input"
           placeholder="@placeholder"
           autocomplete="off" />
    <button type="button" class="filter-search__btn" data-filter-search aria-label="جستجو">
        <i class="fa-solid fa-magnifying-glass"></i>
    </button>
</div>
<button type="button" class="main_bt" data-filter-reset title="بازنشانی فیلترها">
    <i class="fa-solid fa-rotate-left"></i>
</button>
