@using GolpaMotorFinal.Models.ViewModels.CRUD
@using GolpaMotorFinal.Models.ViewModels
@model CrudIndexViewModel

<div class="row column_title">
    <div class="col-md-12">
        <div class="page_title">
            <h2>@Model.Title</h2>
        </div>
    </div>
</div>

<div class="white_shd full margin_bottom_30">
    <div class="full graph_head d-flex flex-wrap justify-content-between align-items-center gap-2">
        <div class="heading1 margin_0">
            <h2>لیست</h2>
        </div>
        <button class="main_bt open-modal"
                data-url='@Model.CreateUrl'
                data-id="null"
                data-title='@Model.CreateTitle'>
            @Model.CreateButtonText
        </button>
    </div>
    <div class="padding_infor_info">
        <div class="table_filter_bar">
            @{
                var sbModel = ViewData["SearchBoxModel"] as SearchBoxViewModel;
                if (sbModel != null)
                {
                    @await Component.InvokeAsync("SearchBox", sbModel)
                }
            }
            <input type="search"
                   class="form-control table-filter-input"
                   data-table-target="#@Model.GridId"
                   placeholder="جستجو در جدول..."
                   autocomplete="off" />
        </div>

        <div class="table_section">
            <div id="@Model.GridId">
                @await Component.InvokeAsync(Model.ViewComponent)
            </div>
        </div>
    </div>
</div>

@{
    var pager = new PaginationViewModel { GridId = Model.GridId };
}
@await Component.InvokeAsync("Pagination", pager)
