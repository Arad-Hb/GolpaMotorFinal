@using GolpaMotorFinal.Models.ViewModels.CRUD
@model CrudIndexViewModel

<div class="white_shd full margin_bottom_30">
    <div class="full graph_head d-flex flex-wrap justify-content-between align-items-center gap-2">
        <div class="heading1 margin_0">
            <h2>@Model.ListHeading</h2>
        </div>
        @if (Model.ShowCreate)
        {
            <button class="main_bt open-modal"
                    data-url='@Model.CreateUrl'
                    data-id="null"
                    data-title='@Model.CreateTitle'>
                @Model.CreateButtonText
            </button>
        }
    </div>
    <div class="padding_infor_info">
        @{
            var filterPartial = Model.FilterPartial ?? ViewData["FilterPartial"] as string;
            if (!string.IsNullOrWhiteSpace(filterPartial))
            {
                var filterModel = ViewData["FilterModel"];
                if (filterModel != null)
                {
                    @await Html.PartialAsync(filterPartial, filterModel)
                }
                else
                {
                    @await Html.PartialAsync(filterPartial)
                }
            }
        }

        <div class="table_section">
            <div id="@Model.GridId"></div>
        </div>
    </div>
</div>
