@model FilterSearchViewModel
<div class="filter-search">
    <input type="search"
           name="@Model.Name"
           value="@Model.Value"
           class="form-control filter-search__input"
           placeholder="@Model.Placeholder"
           autocomplete="off" />
    <button type="button" class="filter-search__btn" data-filter-search aria-label="جستجو">
        <i class="fa-solid fa-magnifying-glass"></i>
    </button>
</div>
