@model GolpaMotorFinal.Models.ViewModels.AdminListPageViewModel

@await Html.PartialAsync("_AdminPageHeader", new GolpaMotorFinal.Models.ViewModels.AdminPageHeaderViewModel
{
    Title = Model.Title,
    Breadcrumb = Model.Breadcrumb
})

<div class="white_shd full margin_bottom_30">
    <div class="full graph_head">
        <div class="heading1 margin_0">
            <h2>@(string.IsNullOrWhiteSpace(Model.Heading) ? "لیست" : Model.Heading)</h2>
        </div>
    </div>
    <div class="padding_infor_info">
        @if (!string.IsNullOrWhiteSpace(Model.FilterPartial))
        {
            @await Html.PartialAsync(Model.FilterPartial)
        }
        <div class="table_section">
            <div id="@Model.GridId"></div>
        </div>
    </div>
</div>
