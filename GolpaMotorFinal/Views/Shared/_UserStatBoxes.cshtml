@model GolpaMotorFinal.Models.ViewModels.UserManagement.UserStatBoxesViewModel

<div class="modal-stat-row">
    <div class="modal-stat-box modal-stat-total">
        <span>کل</span>
        <strong>@Model.TotalEarnedPoints</strong>
    </div>
    <div class="modal-stat-box modal-stat-used">
        <span>مصرف</span>
        <strong>@Model.TotalSettledPoints</strong>
    </div>
    <div class="modal-stat-box modal-stat-remain">
        <span>مانده</span>
        <strong>@Model.RemainedPoints</strong>
    </div>
    <div class="modal-stat-box modal-stat-card">
        <span>کارت</span>
        <strong>@Model.TotalRegisteredCards</strong>
    </div>
</div>
