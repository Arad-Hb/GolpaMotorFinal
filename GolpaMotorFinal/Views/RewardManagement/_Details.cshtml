@model DomainModel.ViewModels.Reward.RewardCatalogDetailsModel
@{
    string Dash(string? value) => string.IsNullOrWhiteSpace(value) ? "—" : value;
}

<div class="modal-compact">
    <div class="modal-details-hero">
        <div class="modal-details-hero-main">
            <div class="modal-details-photo is-empty">
                <i class="fa fa-gift" aria-hidden="true"></i>
            </div>
            <div>
                <div class="modal-details-name">@Dash(Model.Title)</div>
                <div class="modal-details-sub">@(Model.IsCashReward ? "پاداش نقدی" : "پاداش غیرنقدی")</div>
            </div>
        </div>
        @if (Model.IsActive)
        {
            <span class="modal-status-pill is-on">فعال</span>
        }
        else
        {
            <span class="modal-status-pill is-off">غیرفعال</span>
        }
    </div>

    <section class="modal-details-section">
        <h6 class="modal-section-title is-first">شرایط پاداش</h6>
        <div class="modal-info-box-grid">
            <div class="modal-info-box">
                <span>حد نصاب امتیاز</span>
                <strong>@Model.RequiredPoints.ToGroupedNumber()</strong>
            </div>
            <div class="modal-info-box">
                <span>نوع پاداش</span>
                <strong>@(Model.IsCashReward ? "نقدی" : "غیرنقدی")</strong>
            </div>
            <div class="modal-info-box">
                <span>مبلغ نقدی</span>
                <strong>@(Model.IsCashReward ? Model.CashValue.ToGroupedNumber() : "—")</strong>
            </div>
        </div>
    </section>

    <section class="modal-details-section">
        <h6 class="modal-section-title">آمار پاداش</h6>
        <div class="modal-info-box-grid modal-info-box-grid--two">
            <div class="modal-info-box">
                <span>تعداد درخواست‌ها</span>
                <strong>@Model.RequestCount.ToGroupedNumber()</strong>
            </div>
            <div class="modal-info-box">
                <span>وضعیت</span>
                <strong>@(Model.IsActive ? "فعال" : "غیرفعال")</strong>
            </div>
        </div>
    </section>

    <section class="modal-details-section">
        <h6 class="modal-section-title">توضیحات پاداش</h6>
        <div class="modal-description-box">
            @Dash(Model.Description)
        </div>
    </section>

    <div class="form-actions">
        <button type="button" class="btn btn-secondary cancel-modal">بستن</button>
    </div>
</div>
