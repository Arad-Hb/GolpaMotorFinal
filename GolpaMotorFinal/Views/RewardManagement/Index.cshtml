@model GolpaMotorFinal.Models.ViewModels.RewardManagement.RewardIndexViewModel
@using GolpaMotorFinal.Models.ViewModels.CRUD
@{
    Layout = "_AdminLayout";
}

<ul class="nav nav-tabs mb-3" role="tablist">
    <li class="nav-item">
        <button class="nav-link active" data-bs-toggle="tab" data-bs-target="#catalogTab" type="button">کاتالوگ پاداش</button>
    </li>
    <li class="nav-item">
        <button class="nav-link" data-bs-toggle="tab" data-bs-target="#requestTab" type="button">درخواست‌ها</button>
    </li>
</ul>

<div class="tab-content">
    <div class="tab-pane fade show active" id="catalogTab">
        @await Html.PartialAsync("_CrudPage", new CrudIndexViewModel
        {
            GridId = "CatalogGrid",
            CreateUrl = Url.Action("Create", "RewardManagement") ?? "/RewardManagement/Create",
            CreateTitle = "افزودن پاداش",
            CreateButtonText = "افزودن پاداش",
            ListHeading = "لیست پاداش‌ها",
            FilterPartial = "_RewardCatalogFilterBar"
        })
    </div>

    <div class="tab-pane fade" id="requestTab">
        @await Html.PartialAsync("_CrudPage", new CrudIndexViewModel
        {
            GridId = "RequestGrid",
            ListHeading = "درخواست‌های پاداش",
            FilterPartial = "_RewardRequestFilterBar",
            FilterModel = Model
        })
    </div>
</div>

@section Scripts
{
    <script>
        function antiForgeryToken() {
            return $('#antiforgery-form input[name="__RequestVerificationToken"]').val();
        }

        function LoadCatalogs(page) {
            applyTableFilter($("#CatalogGrid").closest(".padding_infor_info").find("[data-filter-bar]"), page);
        }

        function LoadRequests(page) {
            applyTableFilter($("#RequestGrid").closest(".padding_infor_info").find("[data-filter-bar]"), page);
        }

        $(document).on("click", "#CatalogGrid .btnDeleteCatalog", async function (e) {
            e.stopImmediatePropagation();
            const ok = await confirmDelete("این پاداش غیرفعال خواهد شد.");
            if (!ok) return;
            const id = $(this).data("id");
            $.ajax({
                url: "/RewardManagement/Delete",
                type: "POST",
                data: { rewardCatalogID: id },
                headers: { RequestVerificationToken: antiForgeryToken() },
                success: function (res) {
                    if (res.success) {
                        LoadCatalogs();
                        toastSuccess(res.message);
                    } else {
                        toastError(res.message);
                    }
                }
            });
        });

        $(document).on("click", ".btnApproveRequest", async function () {
            const ok = await confirmDelete("این درخواست تأیید و امتیاز کاربر کسر شود؟");
            if (!ok) return;
            const id = $(this).data("id");
            $.ajax({
                url: "/RewardManagement/Approve",
                type: "POST",
                data: { rewardRequestID: id },
                headers: { RequestVerificationToken: antiForgeryToken() },
                success: function (res) {
                    if (res.success) {
                        closeModal();
                        LoadRequests();
                        toastSuccess(res.message);
                    } else {
                        toastError(res.message);
                    }
                }
            });
        });

        $(document).on("click", ".btnRejectRequest", async function () {
            const ok = await confirmDelete("این درخواست رد شود؟");
            if (!ok) return;
            const id = $(this).data("id");
            $.ajax({
                url: "/RewardManagement/Reject",
                type: "POST",
                data: { rewardRequestID: id },
                headers: { RequestVerificationToken: antiForgeryToken() },
                success: function (res) {
                    if (res.success) {
                        closeModal();
                        LoadRequests();
                        toastSuccess(res.message);
                    } else {
                        toastError(res.message);
                    }
                }
            });
        });
    </script>
}
