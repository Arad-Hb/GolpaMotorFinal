@using DomainModel.Models
@using DomainModel.ViewModels.Reward
@{
    var statuses = ViewBag.Statuses as IEnumerable<RewardDeliveryStatus> ?? Enumerable.Empty<RewardDeliveryStatus>();
    var catalogs = ViewBag.Catalogs as IEnumerable<RewardCatalogListItem> ?? Enumerable.Empty<RewardCatalogListItem>();
}
<form class="table_filter_bar" data-filter-bar data-url="/RewardManagement/RequestList" data-target="#RequestGrid">
    @{
        ViewData["SearchPlaceholder"] = "جستجوی کاربر یا پاداش...";
        ViewData["SearchName"] = "SearchTerm";
    }
    @await Html.PartialAsync("_FilterSearch")
    <select name="RewardDeliveryStatusID" class="form-select">
        <option value="">همه وضعیت‌ها</option>
        @foreach (var status in statuses)
        {
            <option value="@status.RewardDeliveryStatusID">@status.Title</option>
        }
    </select>
    <select name="RewardCatalogID" class="form-select">
        <option value="">همه پاداش‌ها</option>
        @foreach (var cat in catalogs)
        {
            <option value="@cat.RewardCatalogID">@cat.Title</option>
        }
    </select>
    @await Component.InvokeAsync("DateRangeFilter", new DateRangeFilterViewModel
    {
        FromName = "fromJalali",
        ToName = "toJalali",
        EmptyLabel = "بازه تاریخ",
        FromPlaceholder = "از تاریخ",
        ToPlaceholder = "تا تاریخ"
    })
    @await Html.PartialAsync("_FilterReset")
</form>
