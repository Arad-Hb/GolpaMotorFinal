@model DomainModel.ViewModels.Reward.RewardRequestListItem
@using DomainModel.Models

<div class="modal-compact">
    <div class="fw-semibold mb-2">@Model.CatalogTitle</div>
    <ul class="list-unstyled">
        <li>کاربر: <strong>@(string.IsNullOrWhiteSpace(Model.UserFullName) ? "نامشخص" : Model.UserFullName)</strong></li>
        <li>موبایل: @Model.PhoneNumber</li>
        <li>حد نصاب: @Model.RequiredPoints</li>
        <li>مانده امتیاز: @Model.RemainedPoints</li>
        <li>تاریخ درخواست: @(Model.RequestDate?.ToLocalTime().ToString("yyyy/MM/dd HH:mm") ?? "-")</li>
        <li>وضعیت: <strong>@Model.StatusTitle</strong></li>
        @if (Model.ReviewedDate.HasValue)
        {
            <li>تاریخ بررسی: @Model.ReviewedDate.Value.ToLocalTime().ToString("yyyy/MM/dd HH:mm")</li>
        }
    </ul>
    @if (!Model.IsComplete && Model.StatusTitle == RewardStatusTitles.Pending)
    {
        <div class="form-actions">
            <button type="button" class="main_bt btnApproveRequest" data-id="@Model.RewardRequestID">تأیید</button>
            <button type="button" class="btn btn-danger btnRejectRequest" data-id="@Model.RewardRequestID">رد</button>
        </div>
    }
</div>
