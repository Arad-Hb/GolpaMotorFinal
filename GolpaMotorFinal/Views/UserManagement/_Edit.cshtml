@model GolpaMotorFinal.Models.ViewModels.UserManagement.UserAddEditViewModel
@using GolpaMotorFinal.Helpers

<crud-form model="Model.CrudFormViewModel">
    @Html.AntiForgeryToken()

    <input asp-for="UserID" type="hidden" />
    <input asp-for="Email" type="hidden" />
    <input asp-for="Password" type="hidden" />
    <input asp-for="IsDeleted" type="hidden" />

    <ul class="nav nav-tabs mb-3" role="tablist">
        <li class="nav-item" role="presentation">
            <button class="nav-link active" id="user-general-tab" data-bs-toggle="tab" data-bs-target="#user-general-pane" type="button" role="tab">اطلاعات کلی</button>
        </li>
        <li class="nav-item" role="presentation">
            <button class="nav-link" id="user-financial-tab" data-bs-toggle="tab" data-bs-target="#user-financial-pane" type="button" role="tab">اطلاعات مالی</button>
        </li>
    </ul>

    <div class="tab-content">
        <div class="tab-pane fade show active" id="user-general-pane" role="tabpanel">
            <div class="row">
                <div class="col-12 col-md-6">
                    <img src="@ImageHelper.ToThumbnail(Model.ProfileImageUrl)"
                         alt=""
                         class="modal-avatar" />
                </div>

                <div class="col-12 col-md-6">
                    <label asp-for="FirstName"></label>
                    <input asp-for="FirstName" class="form-control" />
                    <span asp-validation-for="FirstName" class="text-danger"></span>
                </div>
                <div class="col-12 col-md-6">
                    <label asp-for="LastName"></label>
                    <input asp-for="LastName" class="form-control" />
                    <span asp-validation-for="LastName" class="text-danger"></span>
                </div>
                <div class="col-12 col-md-6">
                    <label asp-for="PhoneNumber"></label>
                    <input asp-for="PhoneNumber" class="form-control" />
                    <span asp-validation-for="PhoneNumber" class="text-danger"></span>
                </div>
                <div class="col-12 col-md-6">
                    <label asp-for="ProvinceID"></label>
                    <select asp-for="ProvinceID" asp-items="Model.Provinces" class="form-select js-user-province">
                        <option value="">انتخاب استان</option>
                    </select>
                    <span asp-validation-for="ProvinceID" class="text-danger"></span>
                </div>
                <div class="col-12 col-md-6">
                    <label asp-for="CityID"></label>
                    <select asp-for="CityID" asp-items="Model.Cities" class="form-select js-user-city">
                        <option value="">انتخاب شهر</option>
                    </select>
                    <span asp-validation-for="CityID" class="text-danger"></span>
                </div>
                <div class="col-12 col-md-6">
                    <label asp-for="PostalCode"></label>
                    <input asp-for="PostalCode" class="form-control" />
                    <span asp-validation-for="PostalCode" class="text-danger"></span>
                </div>
            </div>

            <div class="mt-3">
                <label asp-for="Address"></label>
                <textarea asp-for="Address" class="form-control"></textarea>
                <span asp-validation-for="Address" class="text-danger"></span>
            </div>

            <div class="mt-3">
                <input asp-for="ProfileImage" type="file" class="form-control" />
            </div>

            <div class="mt-3">
                <input asp-for="IsActive" />
                <label asp-for="IsActive">فعال </label>
            </div>
        </div>

        <div class="tab-pane fade" id="user-financial-pane" role="tabpanel">
            <div class="row">
                <div class="col-12">
                    <label asp-for="CreditCartNumber"></label>
                    <input asp-for="CreditCartNumber" class="form-control" autocomplete="off" />
                    <span asp-validation-for="CreditCartNumber" class="text-danger"></span>
                </div>
                <div class="col-12 mt-3">
                    <label asp-for="IBAN"></label>
                    <input asp-for="IBAN" class="form-control" autocomplete="off" />
                    <span asp-validation-for="IBAN" class="text-danger"></span>
                </div>
                <div class="col-12 mt-3">
                    <label asp-for="AccountNumber"></label>
                    <input asp-for="AccountNumber" class="form-control" autocomplete="off" />
                    <span asp-validation-for="AccountNumber" class="text-danger"></span>
                </div>
            </div>
            <p class="text-muted small mt-3 mb-0">برای درخواست پاداش نقدی حداقل یکی از این سه مورد باید تکمیل شود.</p>
        </div>
    </div>

    <div class="mt-4">
        <button type="submit" class="btn btn-warning"> ویرایش </button>
        <button type="button" class="btn btn-warning cancel-modal"> انصراف </button>
    </div>
</crud-form>
