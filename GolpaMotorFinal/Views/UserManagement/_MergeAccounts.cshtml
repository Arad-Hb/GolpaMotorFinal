@model GolpaMotorFinal.Models.ViewModels.UserManagement.MergeAccountsComplexViewModel
@using GolpaMotorFinal.Helpers

<form id="mergeForm"
      class="merge-form admin-form modal-compact"
      asp-controller="UserManagement"
      asp-action="MergeAccounts"
      method="post"
      data-refresh-grid-url="@(ViewBag.RefreshUrl ?? "/UserManagement/Grid")"
      data-grid-id="@(ViewBag.GridId ?? "UserGrid")">

    @Html.AntiForgeryToken()
    @Html.HiddenFor(m => m.CurrentUser.UserID)

    <div class="merge-user-row mb-2">
        <img src="@ImageHelper.ToThumbnail(@Model.CurrentUser.ProfileImageUrl)" alt="" class="modal-avatar" />
        <div class="flex-grow-1 small">
            <strong>@Model.CurrentUser.FullName</strong>
            <div class="text-muted">@Model.CurrentUser.PhoneNumber · امتیاز @Model.CurrentUser.RemainedPoints</div>
        </div>
        <span class="badge bg-secondary">مبدأ</span>
    </div>

    <div class="mb-2">
        @await Component.InvokeAsync("SearchBox", Model.Search)
    </div>

    <div id="mergeResultContainer">
        @await Html.PartialAsync("_MergeResult", Model)
    </div>

    <div class="d-flex gap-2 mt-2">
        <button type="submit" class="main_bt flex-fill">تایید ادغام</button>
        <button type="button" class="btn btn-sm btn-secondary flex-fill cancel-modal">انصراف</button>
    </div>
</form>
