@using GolpaMotorFinal.Models.ViewModels.CRUD
@model CrudGridViewModel

@{
    ViewData["Title"] = "گزارشات";
    Layout = "_AdminLayout";
}

<div class="row column_title">
    <div class="col-md-12">
        <div class="page_title">
            <h2>گزارشات کاربران</h2>
        </div>
    </div>
</div>

<div class="white_shd full margin_bottom_30">
    <div class="full graph_head">
        <div class="heading1 margin_0">
            <h2>جدول امتیاز و کارت</h2>
        </div>
    </div>
    <div class="padding_infor_info">
        <div class="table_filter_bar">
            <input type="search"
                   class="form-control table-filter-input"
                   data-table-target="#UserReportGrid"
                   placeholder="جستجو در جدول..."
                   autocomplete="off" />
        </div>
        <div class="table_section" id="UserReportGrid">
            @await Component.InvokeAsync("CrudGrid", new { model = Model })
        </div>
    </div>
</div>
