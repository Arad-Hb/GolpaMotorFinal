@model UserFilterBarViewModel
<form class="table_filter_bar" data-filter-bar data-url="@Model.Url" data-target="@Model.Target">
    @await Html.PartialAsync("_FilterSearch", FilterSearchViewModel.For("SearchTerm", "نام، فامیلی یا موبایل"))
    <select name="CustomerTypeID" class="form-select">
        <option value="">همه نقش‌ها</option>
        @foreach (var type in Model.CustomerTypes)
        {
            <option value="@type.CustomerTypeID">@type.Title</option>
        }
    </select>
    <select name="ProvinceID" class="form-select">
        <option value="">همه استان‌ها</option>
        @foreach (var p in Model.Provinces)
        {
            <option value="@p.ProvinceID">@p.Name</option>
        }
    </select>
    <select name="CityID" class="form-select">
        <option value="">همه شهرها</option>
    </select>
    @await Html.PartialAsync("_NumberRangeFilter", NumberRangeFilterViewModel.For(
        "PointsFrom", "PointsTo", "امتیاز", "حداقل امتیاز", "حداکثر امتیاز"))
    <select name="IsEligibleForReward" class="form-select">
        <option value="">واجد پاداش</option>
        <option value="true">بله</option>
        <option value="false">خیر</option>
    </select>
    <select name="HasReceivedReward" class="form-select">
        <option value="">پاداش گرفته</option>
        <option value="true">بله</option>
        <option value="false">خیر</option>
    </select>

    @await Component.InvokeAsync("DateRangeFilter", new DateRangeFilterViewModel
    {
        FromName = "CardFromJalali",
        ToName = "CardToJalali",
        EmptyLabel = "بازه تاریخ",
        FromPlaceholder = "از تاریخ",
        ToPlaceholder = "تا تاریخ"
    })
    @await Html.PartialAsync("_FilterReset")
</form>
