@using DomainModel.Models
@{
    var types = ViewBag.CustomerTypes as IEnumerable<CustomerType> ?? Enumerable.Empty<CustomerType>();
    var provinces = ViewBag.Provinces as IEnumerable<Province> ?? Enumerable.Empty<Province>();
}
<form class="table_filter_bar" data-filter-bar data-url="@(ViewData["FilterUrl"] as string ?? "/UserManagement/Grid")" data-target="@(ViewData["FilterTarget"] as string ?? "#UserGrid")">
    @{
        ViewData["SearchPlaceholder"] = "نام، فامیلی یا موبایل";
        ViewData["SearchName"] = "SearchTerm";
    }
    @await Html.PartialAsync("_FilterSearchReset")
    <select name="CustomerTypeID" class="form-select">
        <option value="">همه نقش‌ها</option>
        @foreach (var type in types)
        {
            <option value="@type.CustomerTypeID">@type.Title</option>
        }
    </select>
    <select name="ProvinceID" class="form-select">
        <option value="">همه استان‌ها</option>
        @foreach (var p in provinces)
        {
            <option value="@p.ProvinceID">@p.Name</option>
        }
    </select>
    <select name="CityID" class="form-select">
        <option value="">همه شهرها</option>
    </select>
    @{
        ViewData["NumFromName"] = "PointsFrom";
        ViewData["NumToName"] = "PointsTo";
        ViewData["NumEmptyLabel"] = "امتیاز";
        ViewData["NumFromPlaceholder"] = "حداقل امتیاز";
        ViewData["NumToPlaceholder"] = "حداکثر امتیاز";
    }
    @await Html.PartialAsync("_NumberRangeFilter")
    <select name="IsEligibleForReward" class="form-select">
        <option value="">واجد پاداش</option>
        <option value="true">بله</option>
        <option value="false">خیر</option>
    </select>
    <select name="HasReceivedReward" class="form-select">
        <option value="">پاداش گرفته</option>
        <option value="true">بله</option>
        <option value="false">خیر</option>
    </select>
    @{
        ViewData["DateFromName"] = "CardFromJalali";
        ViewData["DateToName"] = "CardToJalali";
        ViewData["DateEmptyLabel"] = "تاریخ ثبت کارت";
        ViewData["DateFromPlaceholder"] = "ثبت کارت از";
        ViewData["DateToPlaceholder"] = "ثبت کارت تا";
    }
    @await Html.PartialAsync("_DateRangeFilter")
</form>
