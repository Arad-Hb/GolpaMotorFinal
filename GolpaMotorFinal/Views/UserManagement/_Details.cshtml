@model DomainModel.ViewModels.User.UserDetailsModel
@using GolpaMotorFinal.Helpers
@using GolpaMotorFinal.Models.ViewModels.UserManagement
@{
    string Dash(string? value) => string.IsNullOrWhiteSpace(value) ? "—" : value;
    var hasPhoto = !string.IsNullOrWhiteSpace(Model.ProfileImageUrl)
        && Model.ProfileImageUrl.IndexOf("noimage", StringComparison.OrdinalIgnoreCase) < 0;
}

<div class="modal-compact user-details-compact">
    <div class="modal-details-hero">
        <div class="modal-details-hero-main">
            @if (hasPhoto)
            {
                <img src="@ImageHelper.ToThumbnail(Model.ProfileImageUrl)" alt="" class="modal-details-photo" />
            }
            else
            {
                <div class="modal-details-photo is-empty">
                    <i class="fa fa-image"></i>
                    <span>فاقد تصویر</span>
                </div>
            }
            <div>
                <div class="modal-details-name">@Dash($"{Model.FirstName} {Model.LastName}".Trim())</div>
                <div class="modal-details-sub">@Dash(Model.RoleName)</div>
            </div>
        </div>
        @if (Model.IsActive)
        {
            <span class="modal-status-pill is-on">فعال</span>
        }
        else
        {
            <span class="modal-status-pill is-off">غیرفعال</span>
        }
    </div>

    <div class="modal-details-grid">
        <div class="modal-details-cell">
            <span class="modal-details-label">موبایل</span>
            <span class="modal-details-value">@Dash(Model.PhoneNumber)</span>
        </div>
        <div class="modal-details-cell">
            <span class="modal-details-label">ایمیل</span>
            <span class="modal-details-value">@Dash(Model.Email)</span>
        </div>
        <div class="modal-details-cell">
            <span class="modal-details-label">استان</span>
            <span class="modal-details-value">@Dash(Model.Province)</span>
        </div>
        <div class="modal-details-cell">
            <span class="modal-details-label">تاریخ ثبت‌نام</span>
            <span class="modal-details-value">@Model.RegisterDate.ToString("yyyy/MM/dd")</span>
        </div>
        <div class="modal-details-cell">
            <span class="modal-details-label">شهر</span>
            <span class="modal-details-value">@Dash(Model.City)</span>
        </div>
        <div class="modal-details-cell">
            <span class="modal-details-label">کارت بانکی</span>
            <span class="modal-details-value">@Dash(Model.CreditCartNumber)</span>
        </div>
        <div class="modal-details-cell">
            <span class="modal-details-label">آدرس</span>
            <span class="modal-details-value">@Dash(Model.Address)</span>
        </div>
        <div class="modal-details-cell">
            <span class="modal-details-label">شماره شبا</span>
            <span class="modal-details-value">@Dash(Model.IBAN)</span>
        </div>
        <div class="modal-details-cell">
            <span class="modal-details-label">کد پستی</span>
            <span class="modal-details-value">@Dash(Model.PostalCode)</span>
        </div>
        <div class="modal-details-cell">
            <span class="modal-details-label">حساب</span>
            <span class="modal-details-value">@Dash(Model.AccountNumber)</span>
        </div>
    </div>

    @await Html.PartialAsync("_UserStatBoxes", UserStatBoxesViewModel.From(
        Model.TotalEarnedPoints,
        Model.TotalSettledPoints,
        Model.RemainedPoints,
        Model.TotalRegisteredCards))

    <div class="form-actions">
        <button type="button" class="btn btn-secondary cancel-modal">بستن</button>
    </div>
</div>
