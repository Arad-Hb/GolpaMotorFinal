@using DomainModel.Models
@using GolpaMotorFinal.Models.ViewModels.CRUD
@{
    Layout = "_AdminLayout";

    var crudModel = new CrudIndexViewModel
    {
        GridId = "UserGrid",
        CreateUrl = Url.Action("Create", "UserManagement") ?? "/UserManagement/Create",
        CreateTitle = "افزودن کاربر",
        CreateButtonText = "افزودن",
        ListHeading = "لیست کاربران",
        FilterPartial = "_UserFilterBar",
        FilterModel = new UserFilterBarViewModel
        {
            CustomerTypes = ViewBag.CustomerTypes as IEnumerable<CustomerType> ?? Enumerable.Empty<CustomerType>(),
            Provinces = ViewBag.Provinces as IEnumerable<Province> ?? Enumerable.Empty<Province>()
        }
    };
}

@await Html.PartialAsync("_CrudPage", crudModel)

@section Scripts {
    <script src="~/js/userPages.js" asp-append-version="true"></script>
}
