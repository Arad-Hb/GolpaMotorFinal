@using GolpaMotorFinal.Models.ViewModels
@using GolpaMotorFinal.Models.ViewModels.CRUD
@{
    Layout = "_AdminLayout";

    var crudModel = new CrudIndexViewModel
    {
        Title = "مدیریت کاربران",
        GridId = "UserGrid",
        CreateUrl = Url.Action("Create", "UserManagement") ?? "/UserManagement/Create",
        CreateTitle = "افزودن کاربر",
        CreateButtonText = "افزودن",
        Breadcrumb = new BreadcrumbViewModel
        {
            Items =
            {
                new BreadcrumbItemViewModel { Title = "داشبورد", Url = Url.Action("Index", "Admin") },
                new BreadcrumbItemViewModel { Title = "کاربران", Active = true }
            }
        }
    };
    ViewData["FilterPartial"] = "_UserFilterBar";
}

@await Html.PartialAsync("_CrudPage", crudModel)
