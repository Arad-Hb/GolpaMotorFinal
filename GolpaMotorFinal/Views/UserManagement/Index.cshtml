@using GolpaMotorFinal.Models.ViewModels
@model List<GolpaMotorFinal.Models.ViewModels.UserManagement.UserListItemViewModel>

@{
    Layout = "_AdminLayout";

    var crudModel = new CrudIndexViewModel
    {
        Title = "مدیریت کاربران",
        GridId = "UserGrid",
        ViewComponent = "UserList",
        CreateUrl = Url.Action("Create", "UserManagement") ?? "/UserManagement/Create",
        CreateTitle = "افزودن کاربر",
        CreateButtonText = "افزودن"
    };
    ViewData["SearchBoxModel"] = new GolpaMotorFinal.Models.ViewModels.SearchBoxViewModel
    {
        Action = "Search",
        Controller = "UserManagement",
        ComponentId = "userSearch",
        UpdateTargetId = "UserGrid",
        UseAjax = true,
        SearchParameterName = "Search.SearchTerm",
        Placeholder = "شماره موبایل"
    };
}

@await Html.PartialAsync("_CrudPage", crudModel)
