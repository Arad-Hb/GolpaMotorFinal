@model GolpaMotorFinal.Models.ViewModels.UserManagement.UserAddEditViewModel


<crud-form model="Model.CrudFormViewModel">
    @Html.AntiForgeryToken()

    <div class="row">

        <div class="col-md-6">

            <label asp-for="FirstName">نام</label>

            <input asp-for="FirstName" class="form-control" />

        </div>
        <div class="col-md-6">

            <label asp-for="LastName">نام خانوادگی</label>

            <input asp-for="LastName" class="form-control" />

        </div>
        <div class="col-md-6">

            <label asp-for="PhoneNumber">شماره تلفن</label>

            <input asp-for="PhoneNumber" class="form-control" />

        </div>
        <div class="col-md-6">

            <label asp-for="PostalCode">کد پستی</label>

            <input asp-for="PostalCode" class="form-control" />

        </div>

    </div>

    <div class="mt-3">

        <label asp-for="Address">آدرس</label>

        <textarea asp-for="Address" class="form-control"></textarea>

    </div>

    <div class="mt-3">

        <label asp-for="ProfileImage">تصویر کاربر</label>

        <input asp-for="ProfileImage" type="file" class="form-control" />

        <span asp-validation-for="ProfileImage"></span>

    </div>

    <div class="mt-4">


         <button type="submit" class="btn btn-primary">

                 @Model.CrudFormViewModel.SubmitButtonText

        </button>

        <button type="button" class="btn btn-warning cancel-modal"> انصراف </button>

    </div>
</crud-form>
