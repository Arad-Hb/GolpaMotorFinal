@model GolpaMotorFinal.Models.ViewModels.Account.RegisterViewModel
@{
    ViewData["Title"] = "ثبت‌نام";
    ViewData["BodyClass"] = "inner_page login";
}

<div class="full_container">
    <div class="container">
        <div class="center verticle_center py-5">
            <div class="login_section">
                <div class="logo_login">
                    <div class="center">
                        <img src="~/pluto/images/logo/logo_icon.png" alt="گلپا" />
                    </div>
                </div>
                <div class="login_form">
                    <h4 class="mb-3">ثبت‌نام</h4>
                    <form asp-action="Register" method="post">
                        <input type="hidden" asp-for="ReturnUrl" />
                        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
                        <div class="mb-3">
                            <input asp-for="FirstName" class="form-control" placeholder="نام" />
                            <span asp-validation-for="FirstName" class="text-danger"></span>
                        </div>
                        <div class="mb-3">
                            <input asp-for="LastName" class="form-control" placeholder="نام خانوادگی" />
                            <span asp-validation-for="LastName" class="text-danger"></span>
                        </div>
                        <div class="mb-3">
                            <input asp-for="Email" class="form-control" placeholder="ایمیل" />
                            <span asp-validation-for="Email" class="text-danger"></span>
                        </div>
                        <div class="mb-3">
                            <input asp-for="PhoneNumber" class="form-control" placeholder="موبایل" />
                            <span asp-validation-for="PhoneNumber" class="text-danger"></span>
                        </div>
                        <div class="mb-3">
                            <select asp-for="ProvinceID" asp-items="Model.Provinces" class="form-select js-user-province">
                                <option value="">انتخاب استان</option>
                            </select>
                            <span asp-validation-for="ProvinceID" class="text-danger"></span>
                        </div>
                        <div class="mb-3">
                            <select asp-for="CityID" asp-items="Model.Cities" class="form-select js-user-city">
                                <option value="">انتخاب شهر</option>
                            </select>
                            <span asp-validation-for="CityID" class="text-danger"></span>
                        </div>
                        <div class="mb-3">
                            <input asp-for="Password" class="form-control" placeholder="رمز عبور" />
                            <span asp-validation-for="Password" class="text-danger"></span>
                        </div>
                        <div class="mb-3">
                            <input asp-for="ConfirmPassword" class="form-control" placeholder="تکرار رمز عبور" />
                            <span asp-validation-for="ConfirmPassword" class="text-danger"></span>
                        </div>
                        <button type="submit" class="main_bt">ثبت‌نام</button>
                        <p class="mt-3 mb-0">
                            حساب دارید؟
                            <a asp-action="Login" asp-route-returnUrl="@Model.ReturnUrl">ورود</a>
                        </p>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/accountPages.js" asp-append-version="true"></script>
}
