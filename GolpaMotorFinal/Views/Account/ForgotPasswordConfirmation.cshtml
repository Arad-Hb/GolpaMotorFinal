@{
    ViewData["Title"] = "بازیابی رمز عبور";
}

<div class="container py-4">
    <h2>بازیابی رمز عبور</h2>
    <p>اگر حسابی با این ایمیل وجود داشته باشد، لینک بازیابی آماده شده است.</p>
    @if (TempData["ResetUrl"] is string resetUrl && !string.IsNullOrWhiteSpace(resetUrl))
    {
        <p>
            <a href="@resetUrl">تنظیم رمز عبور جدید</a>
        </p>
    }
    <a asp-action="Login">بازگشت به ورود</a>
</div>
