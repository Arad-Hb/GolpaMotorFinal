@model GolpaMotorFinal.Models.ViewModels.Account.ManageViewModel
@using GolpaMotorFinal.Helpers
@{
    ViewData["Title"] = "پنل مشتری";
}

<div class="container py-4">
    <div class="row g-4">
        <div class="col-12 col-lg-4">
            <div class="card h-100">
                <div class="card-body text-center">
                    <img src="@ImageHelper.ToThumbnail(Model.ProfileImageUrl)" class="rounded-circle mb-3" style="width:96px;height:96px;object-fit:cover;" />
                    <h4>@(Model.FirstName) @(Model.LastName)</h4>
                    <p class="text-muted mb-1">@Model.PhoneNumber</p>
                    <p class="mb-0">مانده امتیاز: <strong>@Model.RemainedPoints</strong></p>
                    <p>کارت ثبت‌شده: <strong>@Model.TotalRegisteredCards</strong></p>
                    <p class="mb-1">واجد شرایط پاداش: <strong>@(Model.IsEligibleForReward ? "بله" : "خیر")</strong></p>
                    <p>دریافت پاداش قبلی: <strong>@(Model.HasReceivedReward ? "بله" : "خیر")</strong></p>
                    <button type="button" class="btn btn-warning mt-2" id="btnRequestReward">درخواست پاداش</button>
                </div>
            </div>
        </div>
        <div class="col-12 col-lg-8">
            <div class="card mb-4">
                <div class="card-body admin-form">
                    <h5 class="mb-3">ویرایش پروفایل</h5>
                    <form asp-action="Manage" method="post" enctype="multipart/form-data">
                        @Html.AntiForgeryToken()
                        <div asp-validation-summary="ModelOnly" class="text-danger"></div>
                        <div class="row g-3">
                            <div class="col-12 col-md-6">
                                <label class="form-label">نام</label>
                                <input asp-for="FirstName" class="form-control" />
                            </div>
                            <div class="col-12 col-md-6">
                                <label class="form-label">نام خانوادگی</label>
                                <input asp-for="LastName" class="form-control" />
                            </div>
                            <div class="col-12 col-md-6">
                                <label class="form-label">موبایل</label>
                                <input asp-for="PhoneNumber" class="form-control" />
                            </div>
                            <div class="col-12 col-md-6">
                                <label class="form-label">کد پستی</label>
                                <input asp-for="PostalCode" class="form-control" />
                            </div>
                            <div class="col-12">
                                <label class="form-label">آدرس</label>
                                <textarea asp-for="Address" class="form-control"></textarea>
                            </div>
                            <div class="col-12">
                                <label class="form-label">عکس</label>
                                <input asp-for="ProfileImage" type="file" class="form-control" accept="image/*" />
                            </div>
                            <div class="col-12 col-md-6">
                                <label class="form-label">رمز فعلی</label>
                                <input asp-for="CurrentPassword" type="password" class="form-control" />
                            </div>
                            <div class="col-12 col-md-6">
                                <label class="form-label">رمز جدید</label>
                                <input asp-for="NewPassword" type="password" class="form-control" />
                            </div>
                        </div>
                        <button type="submit" class="btn btn-primary mt-3">ذخیره</button>
                    </form>
                </div>
            </div>
            <div class="card">
                <div class="card-body">
                    <h5 class="mb-3">کارت‌های ثبت‌شده</h5>
                    <div class="table-responsive">
                        <table class="table table-hover align-middle">
                            <thead>
                                <tr>
                                    <th>سریال</th>
                                    <th>محصول</th>
                                    <th>امتیاز</th>
                                    <th>تاریخ</th>
                                </tr>
                            </thead>
                            <tbody>
                                @if (Model.Cards.Any())
                                {
                                    foreach (var card in Model.Cards)
                                    {
                                        <tr>
                                            <td>@card.SerialNumber</td>
                                            <td>@card.ProductName</td>
                                            <td>@card.Points</td>
                                            <td>@card.CreatedAt.ToLocalTime().ToString("yyyy/MM/dd")</td>
                                        </tr>
                                    }
                                }
                                else
                                {
                                    <tr>
                                        <td colspan="4" class="text-center text-muted">کارتی ثبت نشده است</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="rewardRequestModal">
    <div class="modal-dialog modal-lg modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">درخواست پاداش</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body" id="rewardRequestModalBody"></div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function antiForgeryToken() {
            return $('input[name="__RequestVerificationToken"]').first().val();
        }

        function loadEligibleRewards(message, success) {
            $("#rewardRequestModalBody").load("/Account/EligibleRewards", function () {
                if (message) {
                    const box = $("#rewardRequestAlert");
                    box.removeClass("d-none alert-success alert-danger");
                    box.addClass(success ? "alert-success" : "alert-danger");
                    box.text(message);
                }
            });
        }

        $("#btnRequestReward").on("click", function () {
            loadEligibleRewards();
            bootstrap.Modal.getOrCreateInstance(document.getElementById("rewardRequestModal")).show();
        });

        $(document).on("click", ".btnSubmitRewardRequest", function () {
            const id = $(this).data("id");
            $.ajax({
                url: "/Account/RequestReward",
                type: "POST",
                data: { rewardCatalogID: id },
                headers: { RequestVerificationToken: antiForgeryToken() },
                success: function (res) {
                    loadEligibleRewards(res.message, res.success);
                }
            });
        });
    </script>
}
