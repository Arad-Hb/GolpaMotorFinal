@{
    ViewData["Title"] = "خانه";
}
<section class="hero">
    <div class="container">
        <div class="row align-items-center">
            <div class="col-md-6 text-end">
                <h1 class="fw-bold">فروش تخصصی لوازم یدکی خودرو</h1>
                <p>کیفیت اصلی | قیمت مناسب | ارسال سریع به سراسر کشور</p>
                <a asp-controller="ProductManagement" asp-action="Index" class="main_bt">مشاهده محصولات</a>
            </div>
            <div class="col-md-6 text-center">
                <img src="~/images/pics/hero-car.jpg" class="hero-img img-fluid" alt="" />
            </div>
        </div>
    </div>
</section>

<section class="container my-5">
    <h4 class="section-title mb-4">دسته‌بندی‌ها</h4>
    <div class="row g-3">
        <div class="col-6 col-md-3"><div class="category-card">سیستم ترمز</div></div>
        <div class="col-6 col-md-3"><div class="category-card">موتور</div></div>
        <div class="col-6 col-md-3"><div class="category-card">فیلترها</div></div>
        <div class="col-6 col-md-3"><div class="category-card">تعلیق</div></div>
    </div>
</section>

<section class="container my-5">
    <h4 class="section-title mb-4">محصولات منتخب</h4>
    <div class="full gallery_section_inner">
        <div class="row">
            <div class="col-sm-6 col-md-3 margin_bottom_30 mb-4">
                <div class="column">
                    <img class="img-responsive" src="~/images/pics/brake-pad.jpg" alt="لنت ترمز پراید" />
                </div>
                <div class="heading_section">
                    <h4>لنت ترمز پراید</h4>
                    <small>ایساکو</small>
                    <span class="price">850,000 تومان</span>
                    <button type="button" class="main_bt">افزودن به سبد</button>
                </div>
            </div>
            <div class="col-sm-6 col-md-3 mb-4">
                <div class="column">
                    <img class="img-responsive" src="~/images/pics/alternator.jpg" alt="دینام" />
                </div>
                <div class="heading_section">
                    <h4>دینام</h4>
                    <small>ایساکو</small>
                    <span class="price">3,850,000 تومان</span>
                    <button type="button" class="main_bt">افزودن به سبد</button>
                </div>
            </div>
            <div class="col-sm-6 col-md-3 mb-4">
                <div class="column">
                    <img class="img-responsive" src="~/images/pics/waterpump.jpg" alt="واتر پمپ" />
                </div>
                <div class="heading_section">
                    <h4>واتر پمپ</h4>
                    <small>کروز</small>
                    <span class="price">850,000 تومان</span>
                    <button type="button" class="main_bt">افزودن به سبد</button>
                </div>
            </div>
            <div class="col-sm-6 col-md-3 mb-4">
                <div class="column">
                    <img class="img-responsive" src="~/images/pics/radiator.jpg" alt="رادیاتور ال90" />
                </div>
                <div class="heading_section">
                    <h4>رادیاتور ال90</h4>
                    <small>کروز</small>
                    <span class="price">2,450,000 تومان</span>
                    <button type="button" class="main_bt">افزودن به سبد</button>
                </div>
            </div>
        </div>
    </div>
</section>

<section class="features py-5">
    <div class="container text-center">
        <div class="row">
            <div class="col-md-4 mb-2">ارسال سریع</div>
            <div class="col-md-4 mb-2">ضمانت کالا</div>
            <div class="col-md-4 mb-2">پشتیبانی ۲۴ ساعته</div>
        </div>
    </div>
</section>
