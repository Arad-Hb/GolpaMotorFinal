@model DomainModel.ViewModels.Product.ProductStatistics
@using GolpaMotorFinal.Models.ViewModels
@using GolpaMotorFinal.Models.ViewModels.CRUD
@{
    ViewData["Title"] = "محصولات";
    Layout = "_AdminLayout";
    ViewData["FilterPartial"] = "_ProductFilterBar";
}

@await Html.PartialAsync("_AdminPageHeader", AdminPageHeaderViewModel.For("مدیریت محصولات", "محصولات"))

<div class="row column1">
    <div class="col-md-6 col-lg-3">
        <div class="full counter_section">
            <div class="couter_icon"><div><i class="fa fa-boxes-stacked blue1_color"></i></div></div>
            <div class="counter_no">
                <p class="total_no">@(Model?.TotalProducts ?? 0)</p>
                <p class="head_couter">کل محصولات</p>
            </div>
        </div>
    </div>
    <div class="col-md-6 col-lg-3">
        <div class="full counter_section">
            <div class="couter_icon"><div><i class="fa fa-check green_color"></i></div></div>
            <div class="counter_no">
                <p class="total_no">@(Model?.AvailableProducts ?? 0)</p>
                <p class="head_couter">موجود</p>
            </div>
        </div>
    </div>
    <div class="col-md-6 col-lg-3">
        <div class="full counter_section">
            <div class="couter_icon"><div><i class="fa fa-triangle-exclamation red_color"></i></div></div>
            <div class="counter_no">
                <p class="total_no">@(Model?.ProductsWithoutCards ?? 0)</p>
                <p class="head_couter">بدون کارت گارانتی</p>
            </div>
        </div>
    </div>
    <div class="col-md-6 col-lg-3">
        <div class="full counter_section">
            <div class="couter_icon"><div><i class="fa fa-gift purple_color"></i></div></div>
            <div class="counter_no">
                <p class="total_no">@(Model?.TotalRegisteredPoints ?? 0)</p>
                <p class="head_couter">امتیاز ثبت‌شده</p>
            </div>
        </div>
    </div>
</div>

@{
    var crudModel = new CrudIndexViewModel
    {
        Title = "لیست محصولات",
        GridId = "ProductGrid",
        CreateUrl = Url.Action("Create", "ProductManagement") ?? "/ProductManagement/Create",
        CreateTitle = "افزودن محصول",
        CreateButtonText = "افزودن محصول",
        ListHeading = "لیست محصولات",
        Breadcrumb = null
    };
}

<div class="white_shd full margin_bottom_30">
    <div class="full graph_head d-flex flex-wrap justify-content-between align-items-center gap-2">
        <div class="heading1 margin_0"><h2>لیست محصولات</h2></div>
        <button class="main_bt open-modal"
                data-url="@crudModel.CreateUrl"
                data-id="null"
                data-title="@crudModel.CreateTitle">
            @crudModel.CreateButtonText
        </button>
    </div>
    <div class="padding_infor_info">

        @await Html.PartialAsync("_ProductFilterBar")

        <form id="frmAntiForgery">@Html.AntiForgeryToken()</form>
        <div id="ProductGrid"></div>
    </div>
</div>

@section Scripts
{
    <script>
        $(document).on("click", ".btnRemovePicture", async function () {
            const ok = await confirmDelete("عکس محصول حذف شود؟");
            if (!ok) return;
            const id = $(this).data("id");
            const token = $('#frmAntiForgery input[name="__RequestVerificationToken"]').val();
            $.ajax({
                url: '/ProductManagement/RemovePicture',
                type: 'POST',
                data: { productID: id, __RequestVerificationToken: token },
                success: function (res) {
                    if (res.success) {
                        toastSuccess(res.message);
                        applyTableFilter($("#ProductGrid").closest(".padding_infor_info").find("[data-filter-bar]"));
                    } else {
                        toastError(res.message);
                    }
                }
            });
        });
    </script>
}
