@{
    ViewData["Title"] = "محصولات";
    Layout = "_AdminLayout";
    var stats = ViewBag.Stats as DomainModel.ViewModels.Product.ProductStatistics;
}

<div class="row column_title">
    <div class="col-md-12">
        <div class="page_title">
            <h2>مدیریت محصولات</h2>
        </div>
    </div>
</div>

<div class="row column1">
    <div class="col-md-6 col-lg-3">
        <div class="full counter_section">
            <div class="couter_icon"><div><i class="fa fa-boxes-stacked blue1_color"></i></div></div>
            <div class="counter_no">
                <p class="total_no">@(stats?.TotalProducts ?? 0)</p>
                <p class="head_couter">کل محصولات</p>
            </div>
        </div>
    </div>
    <div class="col-md-6 col-lg-3">
        <div class="full counter_section">
            <div class="couter_icon"><div><i class="fa fa-check green_color"></i></div></div>
            <div class="counter_no">
                <p class="total_no">@(stats?.AvailableProducts ?? 0)</p>
                <p class="head_couter">موجود</p>
            </div>
        </div>
    </div>
    <div class="col-md-6 col-lg-3">
        <div class="full counter_section">
            <div class="couter_icon"><div><i class="fa fa-triangle-exclamation red_color"></i></div></div>
            <div class="counter_no">
                <p class="total_no">@(stats?.ProductsWithoutCards ?? 0)</p>
                <p class="head_couter">بدون کارت گارانتی</p>
            </div>
        </div>
    </div>
    <div class="col-md-6 col-lg-3">
        <div class="full counter_section">
            <div class="couter_icon"><div><i class="fa fa-gift purple_color"></i></div></div>
            <div class="counter_no">
                <p class="total_no">@(stats?.TotalRegisteredPoints ?? 0)</p>
                <p class="head_couter">امتیاز ثبت‌شده</p>
            </div>
        </div>
    </div>
</div>

<div class="white_shd full margin_bottom_30">
    <div class="full graph_head d-flex flex-wrap justify-content-between align-items-center gap-2">
        <div class="heading1 margin_0"><h2>لیست محصولات</h2></div>
        <button class="main_bt" id="btnAdd"><i class="fa fa-plus ms-1"></i> افزودن محصول</button>
    </div>
    <div class="padding_infor_info">
        <form class="table_filter_bar" data-filter-bar data-url="/ProductManagement/ProductList" data-target="#ProductGrid">
            @{
                ViewData["SearchPlaceholder"] = "جستجوی نام محصول...";
                ViewData["SearchName"] = "ProductName";
            }
            @await Html.PartialAsync("_FilterSearchReset")
            <select name="IsAvailable" class="form-select">
                <option value="">وضعیت موجودی</option>
                <option value="true">موجود</option>
                <option value="false">ناموجود</option>
            </select>
            <div class="filter-range">
                <input type="number" name="RegisteredFrom" class="form-control" placeholder="ثبت‌شده از" />
                <input type="number" name="RegisteredTo" class="form-control" placeholder="ثبت‌شده تا" />
            </div>
            <div class="filter-range">
                <input type="number" name="RemainingFrom" class="form-control" placeholder="باقی‌مانده از" />
                <input type="number" name="RemainingTo" class="form-control" placeholder="باقی‌مانده تا" />
            </div>
            <div class="filter-range">
                <input type="number" name="PointsFrom" class="form-control" placeholder="امتیاز از" />
                <input type="number" name="PointsTo" class="form-control" placeholder="امتیاز تا" />
            </div>
        </form>
        <form id="frmAntiForgery">
            @Html.AntiForgeryToken()
        </form>
        <div id="ProductGrid"></div>
    </div>
</div>

<div class="modal fade" id="productModal">
    <div class="modal-dialog modal-lg modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">مدیریت محصول</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body" id="modalBody"></div>
        </div>
    </div>
</div>

@section Scripts
{
    <script>
        let currentPage = 0;

        $(function () {
            LoadProducts();
        });

        function productModal() {
            return bootstrap.Modal.getOrCreateInstance(document.getElementById("productModal"));
        }

        function showProductModal() {
            productModal().show();
        }

        function hideProductModal() {
            productModal().hide();
        }

        function productListUrl(page) {
            return "/ProductManagement/ProductList";
        }

        function LoadProducts(page) {
            applyTableFilter($("#ProductGrid").closest(".padding_infor_info").find("[data-filter-bar]"), page);
        }

        $(document).on("click", "#btnAdd", function () {
            $.get("/ProductManagement/Create", function (result) {
                $("#modalBody").html(result);
                showProductModal();
            });
        });

        $(document).on("submit", "#frmCreate", function (e) {
            e.preventDefault();
            var formData = new FormData(this);
            $.ajax({
                url: "/ProductManagement/Create",
                type: "POST",
                data: formData,
                processData: false,
                contentType: false,
                headers: {
                    RequestVerificationToken: $('input[name="__RequestVerificationToken"]', this).val()
                },
                success: function (res) {
                    if (res.success) {
                        hideProductModal();
                        LoadProducts();
                        toastSuccess(res.message);
                    } else {
                        toastError(res.message);
                    }
                }
            });
        });

        $(document).on("click", ".btnEdit", function () {
            $.get("/ProductManagement/Edit", { productID: $(this).data("id") }, function (result) {
                $("#modalBody").html(result);
                showProductModal();
            });
        });

        $(document).on("submit", "#frmEdit", function (e) {
            e.preventDefault();
            var formData = new FormData(this);
            $.ajax({
                url: "/ProductManagement/Edit",
                type: "POST",
                data: formData,
                processData: false,
                contentType: false,
                headers: {
                    RequestVerificationToken: $('input[name="__RequestVerificationToken"]', this).val()
                },
                success: function (res) {
                    if (res.success) {
                        hideProductModal();
                        LoadProducts();
                        toastSuccess(res.message);
                    } else {
                        toastError(res.message);
                    }
                }
            });
        });

        $(document).on("click", ".btnDetails", function () {
            $.get("/ProductManagement/Details", { productID: $(this).data("id") }, function (result) {
                $("#modalBody").html(result);
                showProductModal();
            });
        });

        $(document).on("click", "#ProductGrid .btnDelete", async function (e) {
            e.stopImmediatePropagation();
            const ok = await confirmDelete("این محصول حذف خواهد شد.");
            if (!ok) return;
            const id = $(this).data("id");
            $.ajax({
                url: "/ProductManagement/Delete",
                type: "POST",
                data: { productID: id },
                headers: {
                    RequestVerificationToken: $('#frmAntiForgery input[name="__RequestVerificationToken"]').val()
                },
                success: function (res) {
                    if (res.success) {
                        LoadProducts();
                        toastSuccess(res.message);
                    } else {
                        toastError(res.message);
                    }
                }
            });
        });

        $(document).on("click", ".btnRemovePicture", async function () {
            const ok = await confirmDelete("عکس محصول حذف شود؟");
            if (!ok) return;
            const id = $(this).data("id");
            const token = $('#frmAntiForgery input[name="__RequestVerificationToken"]').val();
            $.ajax({
                url: '/ProductManagement/RemovePicture',
                type: 'POST',
                data: { productID: id, __RequestVerificationToken: token },
                success: function (res) {
                    if (res.success) {
                        toastSuccess(res.message);
                        LoadProducts();
                    } else {
                        toastError(res.message);
                    }
                },
                error: function () {
                    toastError("خطا در ارتباط با سرور");
                }
            });
        });
    </script>
}
