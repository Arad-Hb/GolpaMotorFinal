@model GolpaMotorFinal.Models.ViewModels.ProductManagement.ProductAddEditViewModel
@using GolpaMotorFinal.Helpers

<form id="frmEdit" class="admin-form" enctype="multipart/form-data">
    @Html.AntiForgeryToken()
    <input asp-for="ProductID" type="hidden" />
    <input asp-for="ExistingImageUrl" type="hidden" />
    <div asp-validation-summary="ModelOnly" class="text-danger mb-2"></div>
    <div class="row">
        <div class="col-12 col-md-6">
            <label asp-for="ProductName" class="form-label"><i class="fa fa-box ms-1"></i> نام محصول</label>
            <input asp-for="ProductName" class="form-control" />
            <span asp-validation-for="ProductName" class="text-danger small"></span>
        </div>
        <div class="col-12 col-md-6">
            <label asp-for="ProductPoint" class="form-label"><i class="fa fa-star ms-1"></i> امتیاز محصول</label>
            <input asp-for="ProductPoint" class="form-control" />
            <span asp-validation-for="ProductPoint" class="text-danger small"></span>
        </div>
    </div>
    <div class="mt-3">
        <label asp-for="Description" class="form-label">توضیحات</label>
        <textarea asp-for="Description" class="form-control"></textarea>
    </div>
    <div class="mt-3">
        <img src="@ImageHelper.Fix(Model?.ExistingImageUrl)" class="image-preview img-thumbnail" width="150" />
    </div>
    <div class="mt-3">
        <input asp-for="ImageFile" type="file" class="form-control image-preview-input" accept="image/*" />
    </div>
    <div class="form-check mt-3">
        <input asp-for="IsAvailable" class="form-check-input" />
        <label asp-for="IsAvailable" class="form-check-label">موجود</label>
    </div>
    <div class="row g-2 mt-4">
        <div class="col-12 col-md-6">
            <button type="submit" class="btn btn-warning w-100">ویرایش</button>
        </div>
        <div class="col-12 col-md-6">
            <button type="button" class="btn btn-secondary w-100" onclick="hideProductModal()">انصراف</button>
        </div>
    </div>
</form>
