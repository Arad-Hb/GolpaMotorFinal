<form class="table_filter_bar" data-filter-bar data-url="/ProductManagement/List" data-target="#ProductGrid">
    @await Html.PartialAsync("_FilterSearch", FilterSearchViewModel.For("ProductName", "جستجوی نام محصول..."))
    <select name="IsAvailable" class="form-select">
        <option value="">وضعیت موجودی</option>
        <option value="true">موجود</option>
        <option value="false">ناموجود</option>
    </select>
    @await Html.PartialAsync("_NumberRangeFilter", NumberRangeFilterViewModel.For(
        "RegisteredFrom", "RegisteredTo", "ثبت‌شده", "حداقل ثبت‌شده", "حداکثر ثبت‌شده"))
    @await Html.PartialAsync("_NumberRangeFilter", NumberRangeFilterViewModel.For(
        "RemainingFrom", "RemainingTo", "باقی‌مانده", "حداقل باقی‌مانده", "حداکثر باقی‌مانده"))
    @await Html.PartialAsync("_NumberRangeFilter", NumberRangeFilterViewModel.For(
        "PointsFrom", "PointsTo", "امتیاز", "حداقل امتیاز", "حداکثر امتیاز"))
    @await Html.PartialAsync("_FilterReset")
</form>
